{
  "version": "0.2.0",
  "configurations": [
    // Default F5 target. Its preLaunchTask runs tool/ensure_emulators.ps1:
    // builds functions/lib when stale, reuses or starts the Firebase Emulator
    // Suite (firebase.qa.json, project mevora-d6ed0) and seeds the QA users and
    // the humor catalogue. See docs/HUMOR_LAB.md, "Local emulator QA (F5)".
    {
      "name": "Mevora (development · full emulator suite)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_development.dart",
      "preLaunchTask": "Flutter: Prepare Run (full emulator suite)",
      "toolEnv": {
        "TMP": "${workspaceFolder}/.tmp",
        "TEMP": "${workspaceFolder}/.tmp"
      },
      "args": [
        "--flavor",
        "development",
        "--dart-define=USE_EMULATORS=true",
        "--dart-define=USE_AUTH_EMULATOR=true",
        "--dart-define=USE_MOCK_HUMOR=false",
        "--dart-define=SPOTIFY_CLIENT_ID=b0a808c4c2264b0ba179c2045a8d3445",
        "--dart-define=FIREBASE_APP_CHECK_DEBUG_TOKEN=${env:FIREBASE_APP_CHECK_DEBUG_TOKEN}",
        "--dart-define=QA_EMAIL_A=qa_user_a@mevora.test",
        "--dart-define=QA_EMAIL_B=qa_user_b@mevora.test",
        "--dart-define=QA_PASSWORD=MevoraQa!2026"
      ]
    },
    // Same emulator suite as above, but reachable from real phones.
    //
    // The only difference is FIREBASE_EMULATOR_HOST. Without it the app falls
    // back to 10.0.2.2 (app_config.dart), which is the Android *emulator*
    // alias for the host loopback and means nothing on a physical handset —
    // it fails as firebase_auth/network-request-failed, never as a wrong-host
    // error. firebase.qa.json already binds every emulator to 0.0.0.0, so the
    // host address is the whole missing piece.
    //
    // Windows Firewall blocks these ports inbound by default; see
    // docs/TWO_DEVICE_ACCEPTANCE_SETUP.md for the one-time rule. Phones must
    // be on the same subnet as the host address you enter.
    {
      "name": "Mevora (development · two phones on LAN)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_development.dart",
      "preLaunchTask": "Flutter: Prepare Run (full emulator suite)",
      "toolEnv": {
        "TMP": "${workspaceFolder}/.tmp",
        "TEMP": "${workspaceFolder}/.tmp"
      },
      "args": [
        "--flavor",
        "development",
        "--dart-define=USE_EMULATORS=true",
        "--dart-define=USE_AUTH_EMULATOR=true",
        "--dart-define=USE_MOCK_HUMOR=false",
        "--dart-define=FIREBASE_EMULATOR_HOST=${input:emulatorLanHost}",
        "--dart-define=DISCOVERY_NO_DEMO=true",
        "--dart-define=SPOTIFY_CLIENT_ID=b0a808c4c2264b0ba179c2045a8d3445",
        "--dart-define=FIREBASE_APP_CHECK_DEBUG_TOKEN=${env:FIREBASE_APP_CHECK_DEBUG_TOKEN}",
        "--dart-define=QA_EMAIL_A=qa_user_a@mevora.test",
        "--dart-define=QA_EMAIL_B=qa_user_b@mevora.test",
        "--dart-define=QA_PASSWORD=MevoraQa!2026"
      ]
    },
    // Targets the LIVE Firebase project mevora-d6ed0, no emulators. Currently
    // unusable: Cloud Billing is disabled on mevora-d6ed0, so every deployed
    // callable fails. Use the full emulator suite configuration above instead.
    {
      "name": "Mevora (development)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_development.dart",
      "preLaunchTask": "Flutter: Prepare Run",
      "toolEnv": {
        "TMP": "${workspaceFolder}/.tmp",
        "TEMP": "${workspaceFolder}/.tmp"
      },
      "args": [
        "--flavor",
        "development",
        "--dart-define=USE_MOCK_HUMOR=false",
        "--dart-define=SPOTIFY_CLIENT_ID=b0a808c4c2264b0ba179c2045a8d3445",
        "--dart-define=FIREBASE_APP_CHECK_DEBUG_TOKEN=${env:FIREBASE_APP_CHECK_DEBUG_TOKEN}"
      ]
    },
    // Real carrier SMS through live mevora-d6ed0 Phone Auth. Needs an OPEN
    // Cloud Billing account on the project: without one every send fails
    // before codeSent with "Firebase: billing-not-enabled" and no SMS goes out
    // (see PHONE_AUTH_IMPLEMENTATION.md).
    {
      "name": "Mevora (development · physical SMS)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_development.dart",
      "preLaunchTask": "Flutter: Prepare Run",
      "toolEnv": {
        "TMP": "${workspaceFolder}/.tmp",
        "TEMP": "${workspaceFolder}/.tmp"
      },
      "args": [
        "--flavor",
        "development",
        "--dart-define=USE_EMULATORS=false",
        "--dart-define=USE_MOCK_HUMOR=false",
        "--dart-define=SPOTIFY_CLIENT_ID=b0a808c4c2264b0ba179c2045a8d3445",
        "--dart-define=FIREBASE_APP_CHECK_DEBUG_TOKEN=${env:FIREBASE_APP_CHECK_DEBUG_TOKEN}"
      ]
    },
    {
      "name": "Mevora (development · auth emulator)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_development.dart",
      "preLaunchTask": "Flutter: Prepare Run",
      "toolEnv": {
        "TMP": "${workspaceFolder}/.tmp",
        "TEMP": "${workspaceFolder}/.tmp"
      },
      "args": [
        "--flavor",
        "development",
        "--dart-define=USE_AUTH_EMULATOR=true",
        "--dart-define=USE_MOCK_HUMOR=false",
        "--dart-define=SPOTIFY_CLIENT_ID=b0a808c4c2264b0ba179c2045a8d3445",
        "--dart-define=FIREBASE_APP_CHECK_DEBUG_TOKEN=${env:FIREBASE_APP_CHECK_DEBUG_TOKEN}"
      ]
    },
    {
      "name": "Mevora (staging)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_staging.dart",
      "preLaunchTask": "Flutter: Prepare Run",
      "toolEnv": {
        "TMP": "${workspaceFolder}/.tmp",
        "TEMP": "${workspaceFolder}/.tmp"
      },
      "args": [
        "--flavor",
        "staging",
        "--dart-define=SPOTIFY_CLIENT_ID=b0a808c4c2264b0ba179c2045a8d3445"
      ]
    },
    {
      "name": "Mevora (production)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_production.dart",
      "preLaunchTask": "Flutter: Prepare Run",
      "toolEnv": {
        "TMP": "${workspaceFolder}/.tmp",
        "TEMP": "${workspaceFolder}/.tmp"
      },
      "args": [
        "--flavor",
        "production",
        "--dart-define=SPOTIFY_CLIENT_ID=b0a808c4c2264b0ba179c2045a8d3445"
      ]
    }
  ],
  "inputs": [
    {
      "id": "emulatorLanHost",
      "type": "promptString",
      "description": "Host LAN address the phones should reach the Firebase Emulator Suite on",
      "default": "192.168.1.214"
    }
  ]
}
