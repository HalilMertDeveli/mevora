{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Flutter: Prepare Run",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tool/flutter_prepare.ps1"
      ],
      "options": {
        "env": {
          "TMP": "D:/Mevora/.tmp",
          "TEMP": "D:/Mevora/.tmp"
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "close": true
      },
      "problemMatcher": []
    },
    {
      "label": "Firebase: Ensure Emulators (build + start + seed)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tool/ensure_emulators.ps1"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "close": false
      },
      "problemMatcher": []
    },
    {
      "label": "Flutter: Prepare Run (full emulator suite)",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Firebase: Ensure Emulators (build + start + seed)",
        "Flutter: Prepare Run"
      ],
      "problemMatcher": []
    }
  ]
}
