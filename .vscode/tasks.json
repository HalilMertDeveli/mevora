{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Flutter: Prepare Run",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tool/flutter_prepare.ps1"
      ],
      "options": {
        "env": {
          "TMP": "D:/Mevora/.tmp",
          "TEMP": "D:/Mevora/.tmp"
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "close": true
      },
      "problemMatcher": []
    },
    {
      "label": "Firebase: Ensure Emulators (build + start + seed)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tool/ensure_emulators.ps1"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "close": false
      },
      "problemMatcher": []
    },
    {
      "label": "Flutter: Prepare Run (full emulator suite)",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Firebase: Ensure Emulators (build + start + seed)",
        "Flutter: Prepare Run"
      ],
      "problemMatcher": []
    },
    // Produces the APK to sideload on two real phones for LAN QA.
    //
    // --debug is load-bearing, not a convenience. ACCESS_LOCAL_NETWORK and
    // usesCleartextTraffic live in android/app/src/debug/AndroidManifest.xml,
    // so a profile or release APK cannot reach the emulator suite at all: on
    // Android 16 the sandbox is denied local-network access and every call
    // surfaces as firebase_auth/network-request-failed, which reads as a
    // broken backend rather than a missing permission.
    //
    // Start the emulator suite first (the F5 config does it via
    // ensure_emulators.ps1) and open the firewall once — see
    // docs/TWO_DEVICE_ACCEPTANCE_SETUP.md.
    {
      "label": "Flutter: Build two-phone QA APK (LAN)",
      "type": "shell",
      "command": "flutter",
      "args": [
        "build",
        "apk",
        "--debug",
        "--flavor",
        "development",
        "--dart-define=USE_EMULATORS=true",
        "--dart-define=USE_AUTH_EMULATOR=true",
        "--dart-define=USE_MOCK_HUMOR=false",
        "--dart-define=FIREBASE_EMULATOR_HOST=${input:emulatorLanHost}",
        "--dart-define=DISCOVERY_NO_DEMO=true",
        "--dart-define=SPOTIFY_CLIENT_ID=b0a808c4c2264b0ba179c2045a8d3445",
        "--dart-define=QA_EMAIL_A=qa_user_a@mevora.test",
        "--dart-define=QA_EMAIL_B=qa_user_b@mevora.test",
        "--dart-define=QA_PASSWORD=MevoraQa!2026"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "TMP": "${workspaceFolder}/.tmp",
          "TEMP": "${workspaceFolder}/.tmp"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "emulatorLanHost",
      "type": "promptString",
      "description": "Host LAN address the phones should reach the Firebase Emulator Suite on",
      "default": "192.168.1.214"
    }
  ]
}
