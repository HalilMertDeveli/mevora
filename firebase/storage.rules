rules_version = '2';

// users/{uid}/profile/{imageId} — owner upload/delete
// Pending uploads stay private until moderation publishes them.
// jpg / jpeg / png / webp, max 5 MB.

service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isImage() {
      return request.resource.contentType.matches('image/jpeg')
        || request.resource.contentType.matches('image/jpg')
        || request.resource.contentType.matches('image/png')
        || request.resource.contentType.matches('image/webp');
    }

    function isSmallEnough() {
      return request.resource.size < 5 * 1024 * 1024;
    }

    function isMatchParticipant(matchId) {
      return isAuthenticated()
        && firestore.exists(/databases/(default)/documents/matches/$(matchId))
        && request.auth.uid in firestore.get(/databases/(default)/documents/matches/$(matchId)).data.userIds;
    }

    function isAudio() {
      return request.resource.contentType.matches('audio/mp4')
        || request.resource.contentType.matches('audio/m4a')
        || request.resource.contentType.matches('audio/x-m4a')
        || request.resource.contentType.matches('audio/aac')
        || request.resource.contentType.matches('audio/mpeg');
    }

    function isEncryptedChatBlob() {
      return request.resource.contentType == 'application/octet-stream'
        && request.resource.size < 25 * 1024 * 1024;
    }

    function isChatMediaOk() {
      // New uploads must be client-encrypted blobs only.
      return isEncryptedChatBlob();
    }

    function isActiveMatch(matchId) {
      return firestore.exists(/databases/(default)/documents/matches/$(matchId))
        && firestore.get(/databases/(default)/documents/matches/$(matchId)).data.isActive == true;
    }

    // The server opens an attempt (startFaceAnchorVerification) before any
    // selfie may be uploaded; this is that attempt, still waiting, not expired.
    function isOpenFaceAnchorAttempt(userId, attemptId) {
      return firestore.exists(/databases/(default)/documents/users/$(userId)/faceAnchor/state)
        && firestore.get(/databases/(default)/documents/users/$(userId)/faceAnchor/state).data.attemptId == attemptId
        && firestore.get(/databases/(default)/documents/users/$(userId)/faceAnchor/state).data.status == 'awaiting_selfie'
        && firestore.get(/databases/(default)/documents/users/$(userId)/faceAnchor/state).data.expiresAtMs > request.time.toMillis();
    }

    // Pending uploads are owner-private until moderation publishes to photos/.
    match /users/{userId}/profile/pending/{imageId} {
      allow read: if isOwner(userId);
      allow delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isImage() && isSmallEnough();
    }

    match /users/{userId}/profile/photos/{imageId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if false;
    }

    // B-11: this accepted owner uploads and was readable by every
    // authenticated user, with none of the moderation the photos/ prefix has —
    // a route for unmoderated, client-controlled imagery to become visible
    // profile media. A lifecycle audit found no legitimate writer: the client's
    // uploadProfileImage(thumbnail: true) is never invoked anywhere, and no
    // Cloud Function generates profile thumbnails. Writes are therefore denied
    // outright, exactly like photos/. Reads are unchanged — the finding is
    // about write/moderation authority, and discovery may still reference
    // objects that already exist.
    match /users/{userId}/profile/thumbs/{imageId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if false;
    }

    // Legacy path: read for existing objects; no new client writes (use pending/).
    match /users/{userId}/profile/{imageId} {
      allow read: if isAuthenticated();
      allow create, update: if false;
      allow delete: if isOwner(userId);
    }

    // Chat media: participants only. Prefer encrypted octet-stream (Wave B).
    match /users/{userId}/chat/{matchId}/{fileId} {
      allow read: if isOwner(userId) || isMatchParticipant(matchId);
      allow create, update: if isOwner(userId)
        && isMatchParticipant(matchId)
        && isActiveMatch(matchId)
        && isChatMediaOk();
      allow delete: if isOwner(userId);
    }

    // Face Anchor verification selfie. Biometric, and temporary: the server
    // reads it once and deletes it when the verification ends.
    //
    // Create only, by the owner, and only into the attempt the server has
    // open for them right now — so an object can exist here only while there
    // is an attempt that will clean it up. Nobody can read it back, replace it
    // or delete it from a client: not other members, not the owner.
    match /face-anchor/pending/{userId}/{attemptId} {
      // resource == null: an upload over an existing object is still a
      // "create" to the rules engine, so write-once has to be stated.
      allow create: if isOwner(userId)
        && resource == null
        && isImage()
        && isSmallEnough()
        && isOpenFaceAnchorAttempt(userId, attemptId);
      allow read, update, delete: if false;
    }

    match /users/{userId}/support/{ticketId}/{fileId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isImage() && isSmallEnough();
      allow delete: if isOwner(userId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
