# LiveKit Cloud (or self-hosted). Set via:
#   firebase functions:secrets:set LIVEKIT_API_KEY --project mevora-d6ed0
#   firebase functions:secrets:set LIVEKIT_API_SECRET --project mevora-d6ed0
#   firebase functions:secrets:set LIVEKIT_URL --project mevora-d6ed0
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# LIVEKIT_URL=wss://your-project.livekit.cloud

# Copy to functions/.env for the emulator. Never commit real values.
# Flutter client ID: --dart-define=SPOTIFY_CLIENT_ID=... (see .vscode/launch.json)
# Production secret: firebase functions:secrets:set SPOTIFY_CLIENT_SECRET --project mevora-d6ed0
SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET belongs in Cloud Functions secrets, not this file.

# Didit identity verification. Server-side only — none of these may become a
# dart-define, a Remote Config value, or a client-readable Firestore field.
#   firebase functions:secrets:set DIDIT_API_KEY --project mevora-d6ed0
#   firebase functions:secrets:set DIDIT_WEBHOOK_SECRET --project mevora-d6ed0
#
# DIDIT_API_KEY        authenticates MEVORA to Didit (per Application).
# DIDIT_WEBHOOK_SECRET is the destination's secret_shared_key from
#                      POST /v3/webhook/destinations/. A DIFFERENT value from
#                      the API key — never substitute one for the other.
# DIDIT_WORKFLOW_ID    the console workflow: ID Verification + Passive
#                      Liveness + Face Match 1:1 (+ Device & IP Analysis).
# DIDIT_ENVIRONMENT    sandbox (default) | live. Defaults to sandbox so an
#                      unconfigured deployment never behaves as if it were live.
# DIDIT_BASE_URL       defaults to https://verification.didit.me
DIDIT_WORKFLOW_ID=
DIDIT_ENVIRONMENT=sandbox
# DIDIT_API_KEY and DIDIT_WEBHOOK_SECRET belong in Cloud Functions secrets,
# not this file.
