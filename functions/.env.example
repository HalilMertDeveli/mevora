# LiveKit Cloud (or self-hosted). Set via:
#   firebase functions:secrets:set LIVEKIT_API_KEY --project mevora-d6ed0
#   firebase functions:secrets:set LIVEKIT_API_SECRET --project mevora-d6ed0
#   firebase functions:secrets:set LIVEKIT_URL --project mevora-d6ed0
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# LIVEKIT_URL=wss://your-project.livekit.cloud

# Copy to functions/.env.local for the emulator. Never commit real values.
# Not functions/.env: that file is uploaded with every deploy; only *.local stays on this machine.
# Flutter client ID: --dart-define=SPOTIFY_CLIENT_ID=... (see .vscode/launch.json)
# Production secret: firebase functions:secrets:set SPOTIFY_CLIENT_SECRET --project mevora-d6ed0
SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET belongs in Cloud Functions secrets, not this file.

# Didit identity verification. Server-side only — none of these may become a
# dart-define, a Remote Config value, or a client-readable Firestore field.
#   firebase functions:secrets:set DIDIT_API_KEY --project mevora-d6ed0
#   firebase functions:secrets:set DIDIT_WEBHOOK_SECRET --project mevora-d6ed0
#
# DIDIT_API_KEY        authenticates MEVORA to Didit (per Application).
# DIDIT_WEBHOOK_SECRET is the destination's secret_shared_key from
#                      POST /v3/webhook/destinations/. A DIFFERENT value from
#                      the API key — never substitute one for the other.
# DIDIT_WORKFLOW_ID    the console workflow: ID Verification + Passive
#                      Liveness + Face Match 1:1 (+ Device & IP Analysis).
# DIDIT_ENVIRONMENT    sandbox (default) | live. Defaults to sandbox so an
#                      unconfigured deployment never behaves as if it were live.
#                      PRODUCTION MUST BE live: outside the emulator a sandbox
#                      configuration refuses to start a session and grants no
#                      verified badge, because sandbox mocks the analysis.
# DIDIT_ALLOW_SANDBOX_VERIFICATION
#                      empty (default) | true. The one exception to the line
#                      above: lets a DEPLOYED sandbox application grant the
#                      badge, for a non-production project that runs sandbox
#                      QA. Only the exact value true opts in. Never set it in
#                      production. See docs/DIDIT_INTEGRATION.md.
# DIDIT_BASE_URL       defaults to https://verification.didit.me
DIDIT_WORKFLOW_ID=
DIDIT_ENVIRONMENT=sandbox
# DIDIT_ALLOW_SANDBOX_VERIFICATION=
# DIDIT_API_KEY and DIDIT_WEBHOOK_SECRET belong in Cloud Functions secrets,
# not this file.

# Face Anchor (verified profile photo). See docs/FACE_ANCHOR.md.
# Uses DIDIT_API_KEY above and runs only when DIDIT_ENVIRONMENT=live: a sandbox
# key answers the standalone liveness / face-match APIs with a canned approval.
# The emulator never contacts Didit; it uses a fake provider driven by
# tool/faceAnchorDev.cjs.
#
# FACE_ANCHOR_ENFORCEMENT        on | off. On = a new member cannot finish
#                                onboarding without a verified photo. Unset it
#                                is off in a deployment and on in the emulator.
#                                Turn on only after the app is released and a
#                                live provider is configured.
# FACE_ANCHOR_MATCH_THRESHOLD    0-100, default 50.
# FACE_ANCHOR_LIVENESS_THRESHOLD 0-100, default 30.
# FACE_ANCHOR_DAILY_GLOBAL_CAP   billed verifications per UTC day, default 2000.
# FACE_ANCHOR_ENFORCEMENT=

# Google Play: Boost purchases, Premium subscriptions and Premium RTDN.
#   firebase functions:secrets:set GOOGLE_PLAY_SERVICE_ACCOUNT_JSON --project mevora-d6ed0 --data-file <key file>
#
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON  the Play Developer API service account,
#                                   the whole JSON key file. A secret, bound to
#                                   verifyBoostPurchase, verifyPremiumPurchase,
#                                   onPlaySubscriptionNotification and
#                                   reconcileVoidedBoostPurchases. Create it
#                                   before deploying any of them. Missing in
#                                   a deployment it fails closed: nothing is
#                                   verified and nothing is granted.
#                                   Never bound under the emulator, whose
#                                   test stores answer only while no Play
#                                   credential is present. To run the emulator
#                                   against real Google, set it in
#                                   functions/.env.local instead.
# ANDROID_PACKAGE_NAME              Play package Boost purchases are verified
#                                   against. Defaults to com.mevora.app.
# PREMIUM_ANDROID_PACKAGE_NAME      Play package Premium subscriptions and RTDN
#                                   are verified against. No default: empty
#                                   means no Android purchase can grant Premium.
# PREMIUM_ANDROID_PRODUCT_IDS       comma separated productId[:basePlanId].
#                                   No default. Must list every base plan the
#                                   app sells — the app's own
#                                   --dart-define=PREMIUM_ANDROID_PRODUCT_IDS
#                                   takes the same value.
# PREMIUM_RTDN_TOPIC                Pub/Sub topic Play publishes Real-time
#                                   Developer Notifications to. Defaults to
#                                   play-subscription-rtdn. Read at deploy time.
# ANDROID_PACKAGE_NAME=com.mevora.app
PREMIUM_ANDROID_PACKAGE_NAME=
PREMIUM_ANDROID_PRODUCT_IDS=
# PREMIUM_RTDN_TOPIC=play-subscription-rtdn
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON belongs in Cloud Functions secrets, not this
# file.
