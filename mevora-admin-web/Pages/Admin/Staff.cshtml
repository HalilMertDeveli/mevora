@page
@model Mevora.Admin.Web.Pages.Admin.StaffModel
@{
    ViewData["Title"] = "Staff";
    var me = User.StaffUid();
    var summary = Model.Result.Get("summary");
}
<div class="page-head">
    <div>
        <h1>Staff &amp; roles</h1>
        <p>The staff record is the authority: a change here takes effect on the colleague's next request. Every change is in the audit log.</p>
    </div>
    <span class="muted small">@summary.Num("active") active · @summary.Num("disabled") disabled</span>
</div>
<partial name="_Flash" model="Model" />

<table class="data">
    <thead><tr><th scope="col">Staff</th><th scope="col">Role</th><th scope="col">Status</th><th scope="col">Last console sign-in</th><th scope="col">Added</th><th scope="col">Last role change</th></tr></thead>
    <tbody>
        @foreach (var s in Model.Result.Items())
        {
            var uid = s.S("uid");
            <tr>
                <td>
                    <a href="/Admin/Staff/@Uri.EscapeDataString(uid)"><strong>@s.S("displayName", "(no name)")</strong></a>
                    @if (s.Bool("isOwner")) { <span class="badge badge-info">Owner</span> }
                    @if (s.Bool("qaSeed")) { <span class="badge badge-warn" title="Seeded by tool/seedEmulatorAdminQa.cjs for role testing. Not an employee.">QA · emulator only</span> }
                    @if (uid == me) { <span class="muted small">(you)</span> }
                    <div class="mono small">@s.S("email") · @uid</div>
                </td>
                <td>@JsonView.Label(s.Str("role"))</td>
                <td><span class="status status-@(s.Str("status") == "active" ? "active" : "banned")">@JsonView.Label(s.Str("status"))</span></td>
                <td class="nowrap">
                    @if (s.Str("lastLoginAt") is null) { <span class="muted">Never</span> }
                    else
                    {
                        @s.When("lastLoginAt")
                        @if (s.Has("lastLoginMfa") && s.Get("lastLoginMfa").ValueKind == JsonValueKind.False) { <div><span class="badge badge-warn">no MFA (emulator)</span></div> }
                    }
                </td>
                <td class="nowrap">@s.When("createdAt")<div class="muted small mono">by @s.S("createdBy")</div></td>
                <td class="nowrap">@s.When("lastRoleChangeAt")</td>
            </tr>
        }
    </tbody>
</table>

@if (Model.Can("admin.manage_roles"))
{
    <section class="card">
        <h2>Add staff</h2>
        <p class="small muted">Use the colleague's dedicated work email. You never see or choose their password: Firebase emails them a link to set it, and the console makes them set up two-factor authentication at first sign-in. Super admin cannot be granted here.</p>
        <form method="post" asp-page-handler="Create" data-confirm="Add this colleague and email them a password-setup link?">
            <input type="hidden" name="idempotencyKey" value="@Model.FormKey-create" />
            <div class="field-row">
                <div class="field"><label for="n-email">Work email</label><input id="n-email" name="email" type="email" maxlength="254" required autocomplete="off" /></div>
                <div class="field"><label for="n-name">Display name</label><input id="n-name" name="displayName" type="text" minlength="2" maxlength="80" required /></div>
                <div class="field"><label for="n-role">Role</label>
                    <select id="n-role" name="role">
                        @foreach (var r in Vocab.GrantableRoles) { <option value="@r">@JsonView.Label(r)</option> }
                    </select></div>
            </div>
            <button type="submit" class="btn btn-primary">Add staff</button>
        </form>
    </section>
}
