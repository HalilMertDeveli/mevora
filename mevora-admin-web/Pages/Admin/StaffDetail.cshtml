@page "/Admin/Staff/{uid}"
@model Mevora.Admin.Web.Pages.Admin.StaffDetailModel
@{
    var s = Model.Staff;
    var account = Model.Data.Get("account");
    var activity = Model.Data.Get("activity");
    ViewData["Title"] = s.S("displayName", "Staff member");
    var uidParam = Uri.EscapeDataString(Model.Uid);
}
<div class="page-head">
    <div>
        <h1>@s.S("displayName", "(no name)")
            @if (s.Bool("isOwner")) { <span class="badge badge-info">Owner</span> }
            @if (s.Bool("qaSeed")) { <span class="badge badge-warn">QA · emulator only</span> }
        </h1>
        <p class="mono small">@s.S("email") · @Model.Uid</p>
    </div>
    <a class="btn btn-ghost" href="/Admin/Staff">All staff</a>
</div>
<partial name="_Flash" model="Model" />

@if (Model.Data.ValueKind == JsonValueKind.Object)
{
    <div class="grid grid-main-side">
        <section class="card">
            <h2>Record</h2>
            <dl class="kv">
                <dt>Role</dt><dd>@JsonView.Label(s.Str("role"))</dd>
                <dt>Status</dt><dd><span class="status status-@(s.Str("status") == "active" ? "active" : "banned")">@JsonView.Label(s.Str("status"))</span>
                    @if (s.Str("statusReason") is { } why) { <span class="muted small">— @why</span> }</dd>
                <dt>Added</dt><dd>@s.When("createdAt") <span class="muted small mono">by @s.S("createdBy")</span></dd>
                <dt>Last role change</dt><dd>@s.When("lastRoleChangeAt") <span class="muted small mono">by @s.S("lastRoleChangeBy")</span></dd>
                <dt>Last console sign-in</dt><dd>@s.When("lastLoginAt")
                    @if (s.Get("lastLoginMfa").ValueKind == JsonValueKind.False) { <span class="badge badge-warn">no MFA (emulator)</span> }</dd>
                <dt>Last Firebase sign-in</dt><dd>@account.When("lastSignInAt")</dd>
                <dt>Two-factor</dt><dd>
                    @if (account.Arr("mfaFactors").Any()) { <span class="badge badge-ok">Enrolled: @string.Join(", ", account.Arr("mfaFactors").Select(f => f.GetString()))</span> }
                    else { <span class="badge badge-warn">Not enrolled yet — required at next console sign-in</span> }</dd>
                <dt>Sign-in account</dt><dd>@(account.Bool("disabled") ? "Disabled in Firebase Auth" : account.Bool("exists") ? "Active" : "Missing")</dd>
                <dt>Last activity</dt><dd>@Model.Data.When("lastActivityAt")</dd>
            </dl>
        </section>

        <section class="card">
            <h2>Controls</h2>
            @if (Model.IsSelf)
            {
                <p class="muted">This is your own account. Nobody changes their own role or access.</p>
            }
            else if (s.Bool("isOwner"))
            {
                <div class="alert alert-info small">The owner's account is protected: it cannot be demoted, disabled or signed out from the console. Ownership changes are a separate, deliberate procedure.</div>
            }
            else
            {
                <div class="stack">
                    @if (Model.Can("admin.manage_roles"))
                    {
                        <form method="post" asp-page-handler="Role" class="stack" data-confirm="Change this colleague's role? Their current sessions end.">
                            <div class="field"><label for="role">Role</label>
                                <select id="role" name="role">
                                    @foreach (var r in Vocab.GrantableRoles)
                                    {
                                        <option value="@r" selected="@(r == s.Str("role"))">@JsonView.Label(r)</option>
                                    }
                                </select></div>
                            <button type="submit" class="btn">Change role</button>
                        </form>
                    }
                    <form method="post" asp-page-handler="Revoke" class="stack" data-confirm="End all of this colleague's console sessions?">
                        <div class="field"><label for="revoke-reason">End all sessions</label><input id="revoke-reason" name="reason" type="text" maxlength="500" required placeholder="Reason, e.g. lost laptop" /></div>
                        <button type="submit" class="btn">End sessions</button>
                    </form>
                    @if (s.Str("status") == "active")
                    {
                        <form method="post" asp-page-handler="Activation" data-confirm="Email this colleague a new password-setup link?">
                            <button type="submit" class="btn btn-ghost">Send password-setup email</button>
                        </form>
                        <form method="post" asp-page-handler="Disable" class="stack" data-confirm="Disable this colleague's access and end their sessions?">
                            <div class="field"><label for="disable-reason">Disable access</label><input id="disable-reason" name="reason" type="text" maxlength="500" required placeholder="Reason" /></div>
                            <button type="submit" class="btn btn-danger">Disable</button>
                        </form>
                    }
                    else
                    {
                        <form method="post" asp-page-handler="Enable" class="stack">
                            <div class="field"><label for="enable-reason">Re-enable access</label><input id="enable-reason" name="reason" type="text" maxlength="500" required placeholder="Reason" /></div>
                            <button type="submit" class="btn btn-ok">Re-enable</button>
                        </form>
                    }
                </div>
            }
        </section>
    </div>

    <section class="card">
        <h2>Activity</h2>
        <p class="small muted">All-time counts from the audit log. <a href="/Audit?actor=@uidParam">Everything they did</a> · <a href="/Audit?target=@uidParam">Changes made to their access</a></p>
        <div class="stats">
            @foreach (var tile in StaffDetailModel.ActivityTiles)
            {
                <a class="stat" href="/Audit?actor=@uidParam">
                    <span class="n">@(activity.Num(tile.Key)?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "—")</span>
                    <span class="l">@tile.Label</span>
                </a>
            }
        </div>
    </section>

    <section class="card">
        <h2>Recent actions</h2>
        @if (!Model.Data.Arr("recentActions").Any())
        {
            <p class="muted">No actions yet.</p>
        }
        else
        {
            <table class="data">
                <thead><tr><th scope="col">When</th><th scope="col">Event</th><th scope="col">Target</th></tr></thead>
                <tbody>
                    @foreach (var a in Model.Data.Arr("recentActions"))
                    {
                        <tr>
                            <td class="nowrap">@a.When("createdAt")</td>
                            <td><strong>@a.S("action")</strong></td>
                            <td class="small">@JsonView.Label(a.Str("targetType"))
                                @if (a.Str("targetType") == "user" && a.Str("targetId") is { } tu) { <a class="mono" href="/Users/@Uri.EscapeDataString(tu)">@tu</a> }
                                else { <span class="mono">@a.S("targetId")</span> }
                                @if (a.Str("caseId") is { } cid) { <a href="/Cases/@Uri.EscapeDataString(cid)">case</a> }</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
}
