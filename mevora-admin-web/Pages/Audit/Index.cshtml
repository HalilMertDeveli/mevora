@page
@model Mevora.Admin.Web.Pages.Audit.IndexModel
@{
    ViewData["Title"] = L["Audit log"].Value;
}
<div class="page-head">
    <div>
        <h1>@L["Audit log"]</h1>
        <p>@L["Append-only. Every staff decision, sensitive view, sign-in and staff change. Combine filters to answer \"who did what to whom, and when\". Dates are UTC; both ends are included."]</p>
    </div>
</div>
<partial name="_Flash" model="Model" />
<form method="get" class="filters">
    <div class="field"><label for="actor">@L["Staff UID"]</label><input id="actor" name="actor" type="text" value="@Model.Actor" maxlength="128" /></div>
    <div class="field"><label for="actorRole">@L["Staff role"]</label>
        <select id="actorRole" name="actorRole">
            <option value="">@L["Any"]</option>
            @foreach (var r in Vocab.ActorRoles) { <option value="@r" selected="@(r == Model.ActorRole)">@L.Code(r)</option> }
        </select></div>
    <div class="field"><label for="action">@L["Event"]</label>
        <select id="action" name="action">
            <option value="">@L["Any"]</option>
            @foreach (var a in Vocab.AuditActions) { <option value="@a" selected="@(a == Model.Action)">@L.Code("audit." + a)</option> }
        </select></div>
    <div class="field"><label for="targetType">@L["Target type"]</label>
        <select id="targetType" name="targetType">
            <option value="">@L["Any"]</option>
            @foreach (var t in Vocab.AuditTargetTypes) { <option value="@t" selected="@(t == Model.TargetType)">@L.Code("target." + t)</option> }
        </select></div>
    <div class="field"><label for="target">@L["Target id"]</label><input id="target" name="target" type="text" value="@Model.Target" maxlength="300" placeholder="@L["user uid, ticket id…"]" /></div>
    <div class="field"><label for="caseId">@L["Case"]</label><input id="caseId" name="caseId" type="text" value="@Model.CaseId" maxlength="128" /></div>
    <div class="field"><label for="from">@L["From"]</label><input id="from" name="from" type="date" value="@Model.From" /></div>
    <div class="field"><label for="to">@L["To"]</label><input id="to" name="to" type="date" value="@Model.To" /></div>
    <button type="submit" class="btn btn-primary">@L["Filter"]</button>
    <a class="btn btn-ghost" href="/Audit">@L["Clear"]</a>
</form>
@{
    var rows = Model.Result.Items().ToList();
}
@if (Model.Result.Bool("partial"))
{
    <p class="alert alert-info small">@L["Searched {0} events without filling this page. Use \"Next\" to keep searching, or narrow the date range.", Model.Result.Num("scanned")!]</p>
}
@if (rows.Count == 0)
{
    <p class="muted">@(Model.Filtered ? L["No events match these filters."] : L["No events."])</p>
}
else
{
    <table class="data">
        <thead><tr><th scope="col">@L["When"]</th><th scope="col">@L["Event"]</th><th scope="col">@L["Staff"]</th><th scope="col">@L["Target"]</th><th scope="col">@L["Details"]</th><th scope="col">@L["Request"]</th></tr></thead>
        <tbody>
            @foreach (var e in rows)
            {
                <tr>
                    <td class="nowrap">@L.When(e, "createdAt")</td>
                    <td><strong>@L.Code("audit." + e.Str("action"))</strong><div class="mono small muted">@e.S("action")</div></td>
                    <td class="mono small">
                        @if (e.Str("actorAdminId") is { } actorId && Model.Can("admin.manage_staff") && e.Str("actorRole") != "system")
                        {
                            <a href="/Admin/Staff/@Uri.EscapeDataString(actorId)">@actorId</a>
                        }
                        else
                        {
                            @e.S("actorAdminId")
                        }
                        <div class="muted">@L.Code(e.Str("actorRole"))</div></td>
                    <td class="small">@L.Code("target." + e.Str("targetType"))
                        @if (e.Str("targetType") == "user" && e.Str("targetId") is { } tu) { <a class="mono" href="/Users/@Uri.EscapeDataString(tu)">@tu</a> }
                        else { <span class="mono">@e.S("targetId")</span> }
                        @if (e.Str("caseId") is { } cid) { <div><a href="/Cases/@Uri.EscapeDataString(cid)">@L["case"]</a></div> }</td>
                    <td class="mono small wrap-anywhere">@e.Get("metadata").GetRawText()</td>
                    <td class="mono small">@e.S("requestId")</td>
                </tr>
            }
        </tbody>
    </table>
}
@if (Model.Result.Str("nextCursor") is not null || Model.Pager.HasPrevious)
{
    <partial name="_Pager" model="Model.Pager" />
}
