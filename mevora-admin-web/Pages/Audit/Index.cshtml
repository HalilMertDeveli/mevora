@page
@model Mevora.Admin.Web.Pages.Audit.IndexModel
@{
    ViewData["Title"] = L["Audit log"].Value;
}
<div class="page-head">
    <div>
        <h1>@L["Audit log"]</h1>
        <p>@L["Append-only. Every staff decision, sensitive view, sign-in and role change. Filter by one field at a time."]</p>
    </div>
</div>
<partial name="_Flash" model="Model" />
<form method="get" class="filters">
    <div class="field"><label for="actor">@L["Staff UID"]</label><input id="actor" name="actor" type="text" value="@Model.Actor" maxlength="128" /></div>
    <div class="field"><label for="target">@L["Target id"]</label><input id="target" name="target" type="text" value="@Model.Target" maxlength="300" /></div>
    <div class="field"><label for="action">@L["Event"]</label><input id="action" name="action" type="text" value="@Model.Action" maxlength="64" placeholder="@L["e.g. USER_BANNED"]" /></div>
    <button type="submit" class="btn btn-primary">@L["Filter"]</button>
    <a class="btn btn-ghost" href="/Audit">@L["Clear"]</a>
</form>
@{
    var rows = Model.Result.Items().ToList();
}
@if (rows.Count == 0)
{
    <p class="muted">@L["No events."]</p>
}
else
{
    <table class="data">
        <thead><tr><th scope="col">@L["When"]</th><th scope="col">@L["Event"]</th><th scope="col">@L["Staff"]</th><th scope="col">@L["Target"]</th><th scope="col">@L["Details"]</th><th scope="col">@L["Request"]</th></tr></thead>
        <tbody>
            @foreach (var e in rows)
            {
                <tr>
                    <td class="nowrap">@L.When(e, "createdAt")</td>
                    <td><strong>@L.Code("audit." + e.Str("action"))</strong><div class="mono small muted">@e.S("action")</div></td>
                    <td class="mono small">@e.S("actorAdminId")<div class="muted">@L.Code(e.Str("actorRole"))</div></td>
                    <td class="small">@L.Code("target." + e.Str("targetType")) <span class="mono">@e.S("targetId")</span>
                        @if (e.Str("caseId") is { } cid) { <div><a href="/Cases/@cid">@L["case"]</a></div> }</td>
                    <td class="mono small wrap-anywhere">@e.Get("metadata").GetRawText()</td>
                    <td class="mono small">@e.S("requestId")</td>
                </tr>
            }
        </tbody>
    </table>
    <partial name="_Pager" model="Model.Pager" />
}
