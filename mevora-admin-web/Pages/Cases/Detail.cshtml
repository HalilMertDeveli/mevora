@page "/Cases/{caseId}"
@model Mevora.Admin.Web.Pages.Cases.DetailModel
@{
    var c = Model.Case;
    ViewData["Title"] = $"Case {Model.CaseId}";
    var subjectUid = c.Str("subjectUserId");
}
<div class="page-head">
    <div>
        <h1>@JsonView.Label(c.Str("type")) case</h1>
        <p class="mono">@Model.CaseId</p>
    </div>
    <div class="actions">
        <span class="prio prio-@c.S("priority")">@JsonView.Label(c.Str("priority"))</span>
        <span class="status status-@c.S("status")">@JsonView.Label(c.Str("status"))</span>
        @if (c.Bool("escalated")) { <span class="badge badge-danger">Escalated ×@c.S("escalationLevel", "1")</span> }
    </div>
</div>
<partial name="_Flash" model="Model" />

@if (c.ValueKind == JsonValueKind.Object)
{
<div class="grid grid-main-side">
    <div>
        <section class="card">
            <h2>Summary</h2>
            <dl class="kv">
                <dt>Subject</dt>
                <dd>
                    @if (c.Get("subject").ValueKind == JsonValueKind.Object) { <partial name="_UserChip" model='c.Get("subject")' /> }
                    else { <span class="mono">@c.S("subjectRef")</span> }
                </dd>
                <dt>Summary</dt><dd>@c.S("summary")</dd>
                <dt>Reasons</dt><dd>@string.Join(", ", c.Arr("reasonCodes").Select(r => JsonView.Label(r.GetString())))</dd>
                <dt>Sources</dt><dd>@c.S("sourceCount", "0") (@c.S("reporterCount", "0") distinct reporters)</dd>
                <dt>Assigned</dt><dd>@(c.Str("assigneeName") ?? c.S("assignedTo", "unassigned"))</dd>
                <dt>Opened</dt><dd>@c.When("createdAt")</dd>
                @if (c.Str("resolvedAt") is not null)
                {
                    <dt>Closed</dt><dd>@c.When("resolvedAt") · @JsonView.Label(c.Get("resolution").Str("code"))</dd>
                }
                @if (c.Get("verification").ValueKind == JsonValueKind.Object)
                {
                    <dt>Verification</dt><dd><span class="status status-@c.Get("verification").S("status")">@JsonView.Label(c.Get("verification").Str("status"))</span></dd>
                }
            </dl>
        </section>

        <section class="card">
            <h2>Source records</h2>
            @foreach (var s in c.Arr("sources"))
            {
                <article class="card">
                    <p><span class="badge">@JsonView.Label(s.Str("kind"))</span> <span class="mono small">@s.S("ref")</span>
                        @if (s.Str("exists") == "false") { <span class="badge badge-warn">No longer exists</span> }</p>
                    @switch (s.Str("kind"))
                    {
                        case "report":
                            <dl class="kv">
                                <dt>Reason</dt><dd>@JsonView.Label(s.Str("reason")) <span class="prio prio-@s.S("priority")">@JsonView.Label(s.Str("priority"))</span></dd>
                                <dt>Filed</dt><dd>@s.When("createdAt") by <a class="mono" href="/Users/@s.S("reporterId", "")">@s.S("reporterId")</a></dd>
                                <dt>Description</dt><dd>@s.S("description")</dd>
                                <dt>Related match</dt><dd class="mono">@s.S("matchId")</dd>
                                <dt>Related message</dt><dd><span class="mono">@s.S("messageId")</span> <span class="muted small">(ID only — messages are end-to-end encrypted and cannot be opened)</span></dd>
                            </dl>
                            break;
                        case "photo":
                            <div class="thumbs">
                                @if (Model.Can("photo.read"))
                                {
                                    <img class="thumb" alt="Reported photo" src="/Photos?handler=Preview&uid=@Uri.EscapeDataString(s.S("uid", ""))&imageId=@Uri.EscapeDataString(s.S("imageId", ""))" />
                                }
                                <dl class="kv">
                                    <dt>Status</dt><dd><span class="status status-@s.S("status")">@JsonView.Label(s.Str("status"))</span></dd>
                                    <dt>Reason</dt><dd>@s.S("reason")</dd>
                                </dl>
                            </div>
                            <a class="btn btn-small" href="/Photos">Open photo queue</a>
                            break;
                        case "support_ticket":
                            <p>@s.S("subject") · @JsonView.Label(s.Str("status")?.ToLowerInvariant())</p>
                            <a class="btn btn-small" href="/Support/@s.S("ref", "").Split('/').Last()">Open ticket</a>
                            break;
                        case "appeal":
                            <p>@JsonView.Label(s.Str("actionType")) · @JsonView.Label(s.Str("status"))</p>
                            <p class="msg">@s.S("reason")</p>
                            <a class="btn btn-small" href="/Appeals/@s.S("ref", "").Split('/').Last()">Open appeal</a>
                            break;
                        case "automation_job":
                            <p>@JsonView.Label(s.Str("jobKind")) · @JsonView.Label(s.Str("status"))</p>
                            <p class="small mono">@s.S("error")</p>
                            break;
                        default:
                            <p class="small">@JsonView.Label(s.Str("status"))</p>
                            break;
                    }
                </article>
            }
            @if (c.Num("moreSources") is > 0)
            {
                <p class="muted small">…and @c.Num("moreSources") more source record(s).</p>
            }
        </section>

        <section class="card">
            <h2>Case timeline</h2>
            <ol class="timeline">
                @foreach (var t in c.Arr("timeline"))
                {
                    <li>
                        <div class="t-when">@t.When("createdAt") · @(t.Str("authorName") ?? t.S("authorUid"))</div>
                        @if (t.Str("type") == "internal_note")
                        {
                            <div class="t-note">@t.S("text")</div>
                        }
                        else
                        {
                            <div>@JsonView.Label(t.Str("event"))</div>
                        }
                    </li>
                }
            </ol>
        </section>
    </div>

    <div>
        <section class="card">
            <h2>Work this case</h2>
            @if (Model.IsClosed)
            {
                <p class="muted">This case is closed. A new report opens a new case.</p>
            }
            else
            {
                <div class="actions">
                    @if (Model.Can("case.assign") && !Model.HeldByMe)
                    {
                        <form method="post" asp-page-handler="Claim" class="inline"><button type="submit" class="btn btn-primary">Assign to me</button></form>
                    }
                    @if (Model.Can("case.assign") && Model.HeldByMe)
                    {
                        <form method="post" asp-page-handler="Status" class="inline"><input type="hidden" name="status" value="in_review" /><button type="submit" class="btn">Start review</button></form>
                        <form method="post" asp-page-handler="Status" class="inline"><input type="hidden" name="status" value="waiting" /><button type="submit" class="btn">Waiting on info</button></form>
                        <form method="post" asp-page-handler="Unassign" class="inline"><button type="submit" class="btn btn-ghost">Release</button></form>
                    }
                </div>
                @if (subjectUid is not null)
                {
                    <p><a class="btn" href="/Users/@Uri.EscapeDataString(subjectUid)?caseId=@Uri.EscapeDataString(Model.CaseId)">Act on this member</a></p>
                    <p class="small muted">Warn, suspend, ban and re-verification open on the member's page, already linked to this case.</p>
                }
                @if (Model.Can("case.resolve"))
                {
                    <form method="post" asp-page-handler="Resolve" data-confirm="Close this case? Its open reports close with it.">
                        <h3>Close</h3>
                        <div class="field"><label for="outcome">Outcome</label>
                            <select id="outcome" name="outcome"><option value="resolved">Resolved</option><option value="dismissed">Dismissed</option></select></div>
                        <div class="field"><label for="code">Resolution</label>
                            <select id="code" name="code">
                                @foreach (var r in Vocab.ResolutionCodes) { <option value="@r">@JsonView.Label(r)</option> }
                            </select></div>
                        <div class="field"><label for="resolve-note">Internal note</label><textarea id="resolve-note" name="note" maxlength="4000"></textarea></div>
                        <button type="submit" class="btn btn-ok">Close case</button>
                    </form>
                }
                @if (Model.Can("case.escalate"))
                {
                    <form method="post" asp-page-handler="Escalate" data-confirm="Escalate this case to senior review?">
                        <h3>Escalate</h3>
                        <div class="field"><label for="esc-reason">Why</label><input id="esc-reason" name="reason" type="text" maxlength="500" required /></div>
                        <div class="field"><label for="esc-note">Internal note</label><textarea id="esc-note" name="note" maxlength="4000"></textarea></div>
                        <button type="submit" class="btn btn-danger">Escalate</button>
                    </form>
                }
            }
        </section>

        @if (Model.Can("case.note"))
        {
            <section class="card">
                <h2>Internal note</h2>
                <form method="post" asp-page-handler="Note">
                    <div class="field"><label for="note-text">Visible to staff only — never to the member</label><textarea id="note-text" name="text" maxlength="4000" required></textarea></div>
                    <button type="submit" class="btn">Add note</button>
                </form>
            </section>
        }

        <section class="card">
            <h2>Decisions on this case</h2>
            @if (!c.Arr("actions").Any())
            {
                <p class="muted">None yet.</p>
            }
            else
            {
                <ul>
                    @foreach (var a in c.Arr("actions"))
                    {
                        <li>@JsonView.Label(a.Str("type")) · @JsonView.Label(a.Str("reasonCode")) · <span class="small muted">@a.When("createdAt")</span>
                            @if (a.Str("overturnedByActionId") is not null) { <span class="badge badge-info">Overturned</span> }</li>
                    }
                </ul>
            }
        </section>
    </div>
</div>
}
