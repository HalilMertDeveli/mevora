@page
@model Mevora.Admin.Web.Pages.Cases.IndexModel
@{
    ViewData["Title"] = "Cases";
}
<div class="page-head">
    <div>
        <h1>Moderation cases</h1>
        <p>One case per concern. Active cases are ordered by priority, then by how long they have waited.</p>
    </div>
</div>
<partial name="_Flash" model="Model" />

<form method="get" class="filters">
    <div class="field">
        <label for="status">Status</label>
        <select id="status" name="status">
            @foreach (var s in Mevora.Admin.Web.Pages.Cases.IndexModel.Statuses)
            {
                <option value="@s" selected="@(Model.Status == s)">@JsonView.Label(s)</option>
            }
        </select>
    </div>
    <div class="field">
        <label for="type">Type</label>
        <select id="type" name="type">
            <option value="">All types</option>
            @foreach (var t in Vocab.CaseTypes)
            {
                <option value="@t" selected="@(Model.Type == t)">@JsonView.Label(t)</option>
            }
        </select>
    </div>
    <div class="field">
        <label for="assigned">Assignment</label>
        <select id="assigned" name="assigned">
            <option value="any" selected="@(Model.Assigned == "any")">Anyone</option>
            <option value="me" selected="@(Model.Assigned == "me")">Assigned to me</option>
        </select>
    </div>
    <button type="submit" class="btn btn-primary">Apply</button>
</form>

@{
    var rows = Model.Result.Items().ToList();
}
@if (rows.Count == 0)
{
    <p class="muted">No cases match.</p>
}
else
{
    <table class="data">
        <thead>
            <tr><th scope="col">Priority</th><th scope="col">Type</th><th scope="col">Subject</th><th scope="col">Reasons</th><th scope="col">Sources</th><th scope="col">Status</th><th scope="col">Assigned</th><th scope="col">Age</th></tr>
        </thead>
        <tbody>
            @foreach (var c in rows)
            {
                <tr>
                    <td><span class="prio prio-@c.S("priority")">@JsonView.Label(c.Str("priority"))</span>@if (c.Bool("escalated")) { <span class="badge badge-danger">Escalated</span> }</td>
                    <td><a href="/Cases/@c.S("caseId")">@JsonView.Label(c.Str("type"))</a></td>
                    <td>
                        @if (c.Get("subject").ValueKind == JsonValueKind.Object) { <partial name="_UserChip" model='c.Get("subject")' /> }
                        else { <span class="mono small">@c.S("subjectRef")</span> }
                    </td>
                    <td class="small">@string.Join(", ", c.Arr("reasonCodes").Select(r => JsonView.Label(r.GetString())))</td>
                    <td>@c.S("sourceCount", "0") <span class="muted small">(@c.S("reporterCount", "0") reporters)</span></td>
                    <td><span class="status status-@c.S("status")">@JsonView.Label(c.Str("status"))</span></td>
                    <td class="mono small">@c.S("assignedTo")</td>
                    <td class="nowrap">@c.Age("createdAt")</td>
                </tr>
            }
        </tbody>
    </table>
    <partial name="_Pager" model="Model.Pager" />
}
