@page
@model Mevora.Admin.Web.Pages.Cases.IndexModel
@{
    ViewData["Title"] = L["Cases"].Value;
}
<div class="page-head">
    <div>
        <h1>@L["Moderation cases"]</h1>
        <p>@L["One case per concern. Active cases are ordered by priority, then by how long they have waited."]</p>
    </div>
</div>
<partial name="_Flash" model="Model" />

<form method="get" class="filters">
    <div class="field">
        <label for="status">@L["Status"]</label>
        <select id="status" name="status">
            @foreach (var s in Mevora.Admin.Web.Pages.Cases.IndexModel.Statuses)
            {
                <option value="@s" selected="@(Model.Status == s)">@L.Code(s)</option>
            }
        </select>
    </div>
    <div class="field">
        <label for="type">@L["Type"]</label>
        <select id="type" name="type">
            <option value="">@L["All types"]</option>
            @foreach (var t in Vocab.CaseTypes)
            {
                <option value="@t" selected="@(Model.Type == t)">@L.Code(t)</option>
            }
        </select>
    </div>
    <div class="field">
        <label for="assigned">@L["Assignment"]</label>
        <select id="assigned" name="assigned">
            <option value="any" selected="@(Model.Assigned == "any")">@L["Anyone"]</option>
            <option value="me" selected="@(Model.Assigned == "me")">@L["Assigned to me"]</option>
        </select>
    </div>
    <button type="submit" class="btn btn-primary">@L["Apply"]</button>
</form>

@{
    var rows = Model.Result.Items().ToList();
}
@if (rows.Count == 0)
{
    <p class="muted">@L["No cases match."]</p>
}
else
{
    <table class="data">
        <thead>
            <tr><th scope="col">@L["Priority"]</th><th scope="col">@L["Type"]</th><th scope="col">@L["Subject"]</th><th scope="col">@L["Reasons"]</th><th scope="col">@L["Sources"]</th><th scope="col">@L["Status"]</th><th scope="col">@L["Assigned"]</th><th scope="col">@L["Age"]</th></tr>
        </thead>
        <tbody>
            @foreach (var c in rows)
            {
                <tr>
                    <td><span class="prio prio-@c.S("priority")">@L.Code(c.Str("priority"))</span>@if (c.Bool("escalated")) { <span class="badge badge-danger">@L["Escalated"]</span> }</td>
                    <td><a href="/Cases/@c.S("caseId")">@L.Code(c.Str("type"))</a></td>
                    <td>
                        @if (c.Get("subject").ValueKind == JsonValueKind.Object) { <partial name="_UserChip" model='c.Get("subject")' /> }
                        else { <span class="mono small">@c.S("subjectRef")</span> }
                    </td>
                    <td class="small">@string.Join(", ", c.Arr("reasonCodes").Select(r => L.Code(r.GetString())))</td>
                    <td>@c.S("sourceCount", "0") <span class="muted small">(@L["{0} reporters", c.S("reporterCount", "0")])</span></td>
                    <td><span class="status status-@c.S("status")">@L.Code(c.Str("status"))</span></td>
                    <td class="mono small">@c.S("assignedTo")</td>
                    <td class="nowrap">@L.Age(c, "createdAt")</td>
                </tr>
            }
        </tbody>
    </table>
    <partial name="_Pager" model="Model.Pager" />
}
