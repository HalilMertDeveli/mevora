@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}
<div class="card">
    <h1>Something went wrong</h1>
    <p>The error was logged@(Model.RequestId is null ? "" : $" (ref {Model.RequestId})"). No details are shown here.</p>
    <p><a class="btn" href="/Dashboard">Back to the console</a></p>
</div>
