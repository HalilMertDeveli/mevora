@page
@model Mevora.Admin.Web.Pages.Humor.IndexModel
@{
    ViewData["Title"] = L["Humor"].Value;
}
<div class="page-head">
    <div>
        <h1>@L["Humor Lab moderation"]</h1>
        <p>@L["Reported or borderline humor content. Decisions use the existing humor moderation authority."]</p>
    </div>
</div>
<partial name="_Flash" model="Model" />
<nav class="tabs" aria-label="@L["Humor pages"]">
    <a class="tab active" href="/Humor" aria-current="page">@L["Moderation queue"]</a>
    <a class="tab" href="/Humor/Core">@L["Core sequence"]</a>
</nav>
<nav class="tabs" aria-label="@L["Humor status"]">
    @foreach (var s in Mevora.Admin.Web.Pages.Humor.IndexModel.Statuses)
    {
        <a class="tab @(Model.Status == s ? "active" : "")" href="/Humor?status=@s">@L.Code(s)</a>
    }
</nav>
@{
    var rows = Model.Result.Items().ToList();
}
@if (rows.Count == 0)
{
    <p class="muted">@L["Nothing here."]</p>
}
else
{
    <table class="data">
        <thead><tr><th scope="col">@L["Preview"]</th><th scope="col">@L["Content"]</th><th scope="col">@L["Flags"]</th><th scope="col">@L["Reports"]</th><th scope="col">@L["Waiting"]</th><th scope="col"><span class="muted">@L["Decision"]</span></th></tr></thead>
        <tbody>
            @foreach (var h in rows)
            {
                var content = h.Get("content");
                <tr>
                    <td>@if (content.Str("previewUrl") is { } url) { <img class="thumb" alt="@L["Humor item preview"]" src="@url" loading="lazy" referrerpolicy="no-referrer" /> }</td>
                    <td class="small">
                        <div class="mono">@h.S("contentId")</div>
                        <div>@L.Code(content.Str("type")) · @L.Code(content.Str("category")) · @content.S("language")</div>
                        @if (content.Str("textBody") is { } body) { <div class="msg">@body</div> }
                        <div class="muted">@L["Source"]: @content.S("provider") · @L["active"]: @(content.Bool("active") ? L["yes"].Value : L["no"].Value)</div>
                    </td>
                    <td class="small">@string.Join(", ", content.Get("safetyFlags").ValueKind == JsonValueKind.Object ? content.Get("safetyFlags").EnumerateObject().Where(f => f.Value.ValueKind == JsonValueKind.True).Select(f => L.Code("flag." + f.Name)) : Array.Empty<string>())</td>
                    <td>@h.S("reportCount", "0")</td>
                    <td class="nowrap">@L.Age(h, "updatedAt")</td>
                    <td>
                        @if (Model.Can("humor.moderate"))
                        {
                            <form method="post" asp-page-handler="Decide" class="stack">
                                <input type="hidden" name="contentId" value="@h.S("contentId")" />
                                <label class="small" for="n-@h.S("contentId")">@L["Note"]</label>
                                <input id="n-@h.S("contentId")" name="note" type="text" maxlength="4000" />
                                <div class="actions">
                                    <button type="submit" name="decision" value="approve" class="btn btn-small btn-ok">@L["Approve"]</button>
                                    <button type="submit" name="decision" value="reject" class="btn btn-small btn-danger">@L["Reject"]</button>
                                    <button type="submit" name="decision" value="escalate" class="btn btn-small">@L["Escalate"]</button>
                                </div>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <partial name="_Pager" model="Model.Pager" />
}
