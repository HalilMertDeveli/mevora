@page
@model Mevora.Admin.Web.Pages.Photos.IndexModel
@{
    ViewData["Title"] = L["Photos"].Value;
    var i = 0;
}
<div class="page-head">
    <div>
        <h1>@L["Photo moderation"]</h1>
        <p>@L["Decisions are written to the server-owned moderation ledger and published by the existing pipeline. Oldest first."]</p>
    </div>
</div>
<partial name="_Flash" model="Model" />

<nav class="tabs" aria-label="@L["Photo queue"]">
    @foreach (var f in Mevora.Admin.Web.Pages.Photos.IndexModel.Filters)
    {
        <a class="tab @(Model.Filter == f.Value ? "active" : "")" href="/Photos?filter=@f.Value">@L[f.Label]</a>
    }
</nav>

@{
    var rows = Model.Result.Items().ToList();
}
@if (rows.Count == 0)
{
    <p class="muted">@L["Nothing waiting in this queue."]</p>
}
else
{
    <div class="photo-grid">
        @foreach (var p in rows)
        {
            i++;
            var uid = p.S("uid", "");
            var imageId = p.S("imageId", "");
            var id = $"p{i}";
            <article class="photo-card" aria-labelledby="@id-title">
                <div class="photo-frame">
                    <img alt="@L["Photo under review"]" src="/Photos?handler=Preview&uid=@Uri.EscapeDataString(uid)&imageId=@Uri.EscapeDataString(imageId)" loading="lazy" />
                </div>
                <div class="photo-body">
                    <h2 id="@id-title" class="small"><partial name="_UserChip" model='p.Get("user")' /></h2>
                    <dl class="kv small">
                        <dt>@L["Photo"]</dt><dd class="mono">@imageId @(p.Bool("isPrimary") ? L["(primary)"].Value : "")</dd>
                        <dt>@L["State"]</dt><dd><span class="status status-@p.S("status")">@L.Code(p.Str("status"))</span> · @(p.Bool("published") ? L["published"].Value : L["not yet published"].Value)</dd>
                        <dt>@L["Reason"]</dt><dd>@L.Code(p.Str("reason"))</dd>
                        <dt>@L["Checks"]</dt><dd>@L["{0} attempt(s)", p.S("processingAttempts", "0")] @(p.Str("processingError") is { } err ? $"· {err}" : "")</dd>
                        <dt>@L["Waiting"]</dt><dd>@L.Age(p, "updatedAt")</dd>
                        <dt>@L["Open reports"]</dt><dd>@p.S("openReportCount", "?")</dd>
                        @if (p.Str("faceAnchor") == "verified")
                        {
                            <dt>@L["Face Anchor"]</dt><dd>@L["Verified as the member. Rejecting it removes their verified photo."]</dd>
                        }
                        @if (p.Bool("removedByMember"))
                        {
                            <dt>@L["Profile"]</dt><dd>@L["Removed by the member. Approving deletes the kept copy; the photo is not put back."]</dd>
                        }
                        else if (p.Str("onProfile") == "false")
                        {
                            <dt>@L["Profile"]</dt><dd>@L["Not on the member's profile. A decision is recorded, but the photo is not added back."]</dd>
                        }
                    </dl>
                    @if (p.Str("lock") == "another_reviewer")
                    {
                        <p class="alert alert-warn small">@L["Another reviewer is deciding this photo."]</p>
                    }
                    <form method="post" asp-page-handler="Decide" class="stack">
                        <input type="hidden" name="uid" value="@uid" />
                        <input type="hidden" name="imageId" value="@imageId" />
                        <input type="hidden" name="filter" value="@Model.Filter" />
                        <input type="hidden" name="idempotencyKey" value="@Model.FormKey-@i" />
                        <div class="field"><label for="@id-reason">@L["Reason (required to reject)"]</label>
                            <select id="@id-reason" name="reasonCode" data-requires-for="@id-reject">
                                <option value="">—</option>
                                @foreach (var r in Vocab.PhotoRejectReasons) { <option value="@r">@L.Code(r)</option> }
                            </select></div>
                        <div class="field"><label for="@id-note">@L["Internal note"]</label><input id="@id-note" name="internalNote" type="text" maxlength="4000" /></div>
                        <div class="actions">
                            @if (Model.Can("photo.approve"))
                            {
                                <button type="submit" name="decision" value="approve" class="btn btn-ok">@L["Approve"]</button>
                            }
                            @if (Model.Can("photo.reject"))
                            {
                                <button type="submit" name="decision" value="reject" id="@id-reject" class="btn btn-danger">@L["Reject"]</button>
                            }
                            @if (Model.Can("photo.escalate"))
                            {
                                <button type="submit" name="decision" value="escalate" class="btn">@L["Escalate"]</button>
                            }
                        </div>
                    </form>
                </div>
            </article>
        }
    </div>
    <partial name="_Pager" model="Model.Pager" />
}
