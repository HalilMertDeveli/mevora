@using Microsoft.Extensions.Options
@using Mevora.Admin.Web.Configuration
@inject IOptions<AdminWebOptions> AdminOptions
@{
    var signedIn = User.Identity?.IsAuthenticated == true;
    var path = Context.Request.Path.Value ?? "/";
    string Active(string prefix) => path.StartsWith(prefix, StringComparison.OrdinalIgnoreCase) ? "nav-link active" : "nav-link";
    var nav = new (string Href, string Label, string Permission)[]
    {
        ("/Dashboard", "Dashboard", "dashboard.read"),
        ("/Users", "Users", "user.read"),
        ("/Cases", "Cases", "case.read"),
        ("/Reports", "Reports", "report.read"),
        ("/Photos", "Photos", "photo.read"),
        ("/Humor", "Humor", "humor.read"),
        ("/Verification", "Verification", "verification.read"),
        ("/Support", "Support", "support.read"),
        ("/Automation", "Automation", "automation.read"),
        ("/Appeals", "Appeals", "appeal.read"),
        ("/Audit", "Audit log", "audit.read"),
        ("/Admin/Staff", "Staff", "admin.manage_staff"),
        ("/AppControl", "App control", "app_control.read"),
    };
    var env = AdminOptions.Value.EnvironmentLabel;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@(ViewData["Title"] is string t ? $"{t} · " : "")Mevora Trust &amp; Safety</title>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <script src="~/js/admin.js" asp-append-version="true" defer></script>
</head>
<body class="@(signedIn ? "app" : "app app-anonymous")">
    <a class="skip-link" href="#main">Skip to content</a>
    @if (signedIn)
    {
        <aside class="sidebar" aria-label="Console navigation">
            <div class="brand">
                <span class="brand-mark" aria-hidden="true">M</span>
                <span class="brand-text">Trust &amp; Safety</span>
            </div>
            <nav>
                <ul class="nav-list">
                    @foreach (var item in nav)
                    {
                        if (User.Can(item.Permission))
                        {
                            <li><a class="@Active(item.Href)" href="@item.Href">@item.Label</a></li>
                        }
                    }
                </ul>
            </nav>
            <p class="sidebar-note">Access is checked on the server for every action. Hidden items are a convenience, not a control.</p>
        </aside>
    }
    <div class="main-column">
        @if (signedIn)
        {
            <header class="topbar">
                <span class="env env-@env.ToLowerInvariant()">@env</span>
                @if (!User.UsedMfa())
                {
                    <span class="badge badge-warn" title="Production always requires two-factor sign-in.">MFA not used (emulator)</span>
                }
                <span class="topbar-spacer"></span>
                <span class="who">
                    <strong>@User.Identity?.Name</strong>
                    <span class="role">@JsonView.Label(User.StaffRole())</span>
                    @if (User.IsOwner()) { <span class="badge badge-info">Owner</span> }
                </span>
                <form method="post" action="/Logout" class="inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-ghost">Sign out</button>
                </form>
            </header>
        }
        <main id="main" class="content" tabindex="-1">
            @RenderBody()
        </main>
    </div>
</body>
</html>
