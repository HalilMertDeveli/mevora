@page "{code:int?}"
@model StatusModel
@{
    ViewData["Title"] = L[Model.Title].Value;
}
<div class="@(User.Identity?.IsAuthenticated == true ? "" : "login-wrap")">
    <div class="card">
        <h1>@L[Model.Title]</h1>
        <p>@L[Model.Message]</p>
        <p><a class="btn" href="@(User.Identity?.IsAuthenticated == true ? "/Dashboard" : "/Login")">@L["Back to the console"]</a></p>
    </div>
</div>
