@page
@model Mevora.Admin.Web.Pages.Support.IndexModel
@{
    ViewData["Title"] = L["Support"].Value;
}
<div class="page-head">
    <div>
        <h1>@L["Support tickets"]</h1>
        <p>@L["Tickets from the app and from the public support site, newest first."]</p>
    </div>
</div>
<partial name="_Flash" model="Model" />
<form method="get" class="filters">
    <div class="field">
        <label for="status">@L["Status"]</label>
        <select id="status" name="status">
            @foreach (var s in Mevora.Admin.Web.Pages.Support.IndexModel.Statuses)
            {
                <option value="@s" selected="@(Model.Status == s)">@L.Code(s)</option>
            }
        </select>
    </div>
    <div class="field">
        <label for="assigned">@L["Assignment"]</label>
        <select id="assigned" name="assigned">
            <option value="any" selected="@(Model.Assigned == "any")">@L["Anyone"]</option>
            <option value="me" selected="@(Model.Assigned == "me")">@L["Assigned to me"]</option>
        </select>
    </div>
    <button type="submit" class="btn btn-primary">@L["Apply"]</button>
</form>
@{
    var rows = Model.Result.Items().ToList();
}
@if (rows.Count == 0)
{
    <p class="muted">@L["No tickets."]</p>
}
else
{
    <table class="data">
        <thead><tr><th scope="col">@L["Priority"]</th><th scope="col">@L["Subject"]</th><th scope="col">@L["Category"]</th><th scope="col">@L["From"]</th><th scope="col">@L["Status"]</th><th scope="col">@L["Assigned"]</th><th scope="col">@L["Opened"]</th></tr></thead>
        <tbody>
            @foreach (var t in rows)
            {
                <tr>
                    <td><span class="prio prio-@t.S("priority")">@L.Code(t.Str("priority"))</span></td>
                    <td><a href="/Support/@t.S("ticketId")">@t.S("subject")</a> @if (t.Bool("escalated")) { <span class="badge badge-danger">@L["Escalated"]</span> }</td>
                    <td>@L.Code(t.Str("category"))</td>
                    <td>
                        <span class="badge">@L.Code("source." + t.Str("source"))</span>
                        @if (t.Get("user").ValueKind == JsonValueKind.Object) { <partial name="_UserChip" model='t.Get("user")' /> }
                        else if (!t.Bool("userIdVerified")) { <span class="muted small">@L["unverified sender"]</span> }
                    </td>
                    <td><span class="status status-@t.S("status")">@L.Code(t.Str("status"))</span></td>
                    <td class="mono small">@t.S("assignedTo")</td>
                    <td class="nowrap">@L.Age(t, "createdAt")</td>
                </tr>
            }
        </tbody>
    </table>
    <partial name="_Pager" model="Model.Pager" />
}
