@page "/Users/{uid}"
@model Mevora.Admin.Web.Pages.Users.DetailModel
@{
    var o = Model.Overview;
    var account = o.Get("account");
    var auth = o.Get("auth");
    var profile = o.Get("profile");
    var verification = o.Get("verification");
    var safety = o.Get("safety");
    var subscription = o.Get("subscription");
    ViewData["Title"] = account.S("displayName", Model.Uid);
    var isStaff = account.Bool("isStaff");
    string YesNo(bool value) => value ? L["yes"].Value : L["no"].Value;
}
<div class="page-head">
    <div>
        <h1>@(account.Str("displayName") is { Length: > 0 } name ? name : L["(no name)"].Value)</h1>
        <p class="mono">@Model.Uid</p>
    </div>
    <div class="actions">
        <span class="status status-@Model.Status">@L.Code(Model.Status)</span>
        @if (o.Bool("isVerified"))
        {
            <span class="badge badge-ok">@L["Identity verified"]</span>
        }
        @if (isStaff)
        {
            <span class="badge badge-info">@L["Staff"] · @L.Code(account.Str("staffRole"))</span>
        }
    </div>
</div>
<partial name="_Flash" model="Model" />
@if (Model.LinkedCaseId is not null)
{
    <p class="alert alert-info small">@L["Working case"] <a class="mono" href="/Cases/@Model.LinkedCaseId">@Model.LinkedCaseId</a> — @L["decisions below are linked to it."]</p>
}

@if (o.ValueKind == JsonValueKind.Object)
{
<div class="grid grid-main-side">
    <div>
        <section class="card">
            <h2>@L["Account"]</h2>
            <dl class="kv">
                <dt>@L["Status"]</dt>
                <dd>
                    <span class="status status-@Model.Status">@L.Code(Model.Status)</span>
                    @if (account.Str("suspendedUntil") is not null)
                    {
                        <span class="muted"> @L["until"] @L.When(account, "suspendedUntil")</span>
                    }
                    @if (account.Str("statusReasonCode") is { } src)
                    {
                        <span class="muted"> · @L.Code(src)</span>
                    }
                </dd>
                <dt>@L["Warnings"]</dt><dd>@account.S("warningCount", "0")</dd>
                <dt>@L["Created"]</dt><dd>@L.When(account, "createdAt")</dd>
                <dt>@L["Last active"]</dt><dd>@L.When(account, "lastActiveAt")</dd>
                <dt>@L["Sign-in"]</dt>
                <dd>
                    @(auth.Bool("exists") ? (auth.Str("disabled") == "true" ? L["Disabled"].Value : L["Enabled"].Value) : L["No Auth record"].Value)
                    · @L["phone verified"]: @YesNo(auth.Bool("phoneVerified"))
                    · @L["last sign-in"] @auth.S("lastSignInAt")
                </dd>
                <dt>@L["Email"]</dt><dd class="mono">@auth.S("email")</dd>
                <dt>@L["Phone"]</dt><dd class="mono">@auth.S("phone")</dd>
                @if (o.Bool("sensitiveIncluded"))
                {
                    <dt>@L["Providers"]</dt><dd>@string.Join(", ", auth.Arr("providers").Select(p => p.GetString()))</dd>
                }
            </dl>
            @if (!o.Bool("sensitiveIncluded") && Model.Can("user.read_sensitive"))
            {
                <form method="post" asp-page-handler="Reveal" class="field-row">
                    <div class="field">
                        <label for="justification">@L["Reveal contact details — reason (recorded in the audit log)"]</label>
                        <input id="justification" name="justification" type="text" maxlength="300" required placeholder="@L["e.g. identity check for ticket #…"]" />
                    </div>
                    <button type="submit" class="btn">@L["Reveal"]</button>
                </form>
            }
            else if (o.Bool("sensitiveIncluded"))
            {
                <p class="alert alert-warn small">@L["Contact details shown. This view was recorded as SENSITIVE_PROFILE_VIEWED."]</p>
            }
        </section>

        <section class="card">
            <h2>@L["Profile"]</h2>
            <dl class="kv">
                <dt>@L["Completed"]</dt><dd>@YesNo(profile.Bool("profileCompleted"))</dd>
                <dt>@L["Discoverable"]</dt><dd>@YesNo(profile.Bool("isDiscoverable"))</dd>
                <dt>@L["Profile moderation"]</dt><dd><span class="status status-@profile.S("profileModerationStatus", "none")">@L.Code(profile.Str("profileModerationStatus"))</span></dd>
                <dt>@L["City"]</dt><dd>@profile.S("city")</dd>
                <dt>@L["Relationship goal"]</dt><dd>@L.Code(profile.Str("relationshipGoal"))</dd>
                <dt>@L["Photos"]</dt><dd>@L["{0} approved of {1}", profile.S("approvedPhotoCount", "0"), profile.S("photoCount", "0")]</dd>
                <dt>@L["Bio"]</dt><dd>@profile.S("bio")</dd>
            </dl>
            <h3>@L["Photos"]</h3>
            <div class="thumbs">
                @foreach (var p in o.Arr("photos"))
                {
                    <figure class="small">
                        @if (Model.Can("photo.read"))
                        {
                            <img class="thumb" alt="@L["Photo"] @p.S("imageId")" src="/Photos?handler=Preview&uid=@Uri.EscapeDataString(Model.Uid)&imageId=@Uri.EscapeDataString(p.S("imageId", ""))" loading="lazy" />
                        }
                        <figcaption><span class="status status-@p.S("status")">@L.Code(p.Str("status"))</span></figcaption>
                    </figure>
                }
            </div>
        </section>

        <section class="card">
            <h2>@L["Safety"]</h2>
            <p>@L["Reports received"]: <strong>@safety.S("reportsReceivedCount", "?")</strong> · @L["Reports filed"]: <strong>@safety.S("reportsSubmittedCount", "?")</strong></p>
            <h3>@L["Recent reports against this member"]</h3>
            @if (!safety.Arr("recentReports").Any())
            {
                <p class="muted">@L["None."]</p>
            }
            else
            {
                <table class="data">
                    <thead><tr><th scope="col">@L["When"]</th><th scope="col">@L["Reason"]</th><th scope="col">@L["Priority"]</th><th scope="col">@L["Status"]</th><th scope="col">@L["Case"]</th></tr></thead>
                    <tbody>
                        @foreach (var r in safety.Arr("recentReports"))
                        {
                            <tr>
                                <td class="nowrap">@L.When(r, "createdAt")</td>
                                <td>@L.Code(r.Str("reason"))</td>
                                <td><span class="prio prio-@r.S("priority")">@L.Code(r.Str("priority"))</span></td>
                                <td><span class="status status-@r.S("status")">@L.Code(r.Str("status"))</span></td>
                                <td>@if (r.Str("caseId") is { } cid) { <a class="mono" href="/Cases/@cid">@L["open"]</a> }</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            <h3>@L["Open cases"]</h3>
            @if (!safety.Arr("openCases").Any())
            {
                <p class="muted">@L["None."]</p>
            }
            else
            {
                <ul>
                    @foreach (var c in safety.Arr("openCases"))
                    {
                        <li><a href="/Cases/@c.S("caseId")">@L.Code(c.Str("type"))</a> · <span class="prio prio-@c.S("priority")">@L.Code(c.Str("priority"))</span> · @L.Code(c.Str("status"))</li>
                    }
                </ul>
            }
            <h3>@L["Moderation history"]</h3>
            @if (!safety.Arr("actions").Any())
            {
                <p class="muted">@L["No moderation actions."]</p>
            }
            else
            {
                <table class="data">
                    <thead><tr><th scope="col">@L["When"]</th><th scope="col">@L["Action"]</th><th scope="col">@L["Reason"]</th><th scope="col">@L["By"]</th><th scope="col">@L["Notes"]</th></tr></thead>
                    <tbody>
                        @foreach (var a in safety.Arr("actions"))
                        {
                            <tr>
                                <td class="nowrap">@L.When(a, "createdAt")</td>
                                <td>@L.Code(a.Str("type"))</td>
                                <td>@L.Code(a.Str("reasonCode"))</td>
                                <td class="mono">@a.S("actorAdminId")</td>
                                <td class="small">
                                    @if (a.Str("expiresAt") is not null) { <span>@L["until"] @L.When(a, "expiresAt")</span> }
                                    @if (a.Str("overturnedByActionId") is not null) { <span class="badge badge-info">@L["Overturned"]</span> }
                                    @if (a.Str("authSync") is "failed") { <span class="badge badge-danger">@L["Auth sync failed — retry the action"]</span> }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>

        <section class="card">
            <h2>@L["Safety timeline"]</h2>
            @if (!Model.Timeline.Arr("events").Any())
            {
                <p class="muted">@L["No events."]</p>
            }
            else
            {
                <ol class="timeline">
                    @foreach (var e in Model.Timeline.Arr("events"))
                    {
                        <li>
                            <div class="t-when">@L.When(e, "at")</div>
                            <div>@L.TimelineTitle(e)</div>
                        </li>
                    }
                </ol>
                @if (Model.Timeline.Num("nextBeforeMs") is { } next)
                {
                    <a class="btn btn-small" href="/Users/@Uri.EscapeDataString(Model.Uid)?before=@next">@L["Older events"]</a>
                }
            }
        </section>
    </div>

    <div>
        <section class="card">
            <h2>@L["Actions"]</h2>
            @if (isStaff)
            {
                <p class="alert alert-info small">@L["This member is staff. Senior staff and super admins are protected from sanctions by the server."]</p>
            }

            @if (Model.Can("user.warn"))
            {
                <details>
                    <summary><strong>@L["Warn"]</strong></summary>
                    <form method="post" asp-page-handler="Warn" data-confirm="@L["Issue a warning to this member?"]">
                        <input type="hidden" name="idempotencyKey" value="@Model.FormKey-warn" />
                        <div class="field"><label for="warn-reason">@L["Reason"]</label>
                            <select id="warn-reason" name="reasonCode" required>
                                @foreach (var r in Vocab.ReasonCodes) { <option value="@r">@L.Code(r)</option> }
                            </select></div>
                        <div class="field"><label for="warn-msg">@L["Message to the member (optional)"]</label>
                            <textarea id="warn-msg" name="userMessage" maxlength="1000"></textarea></div>
                        <div class="field"><label for="warn-case">@L["Link to case (optional)"]</label>
                            <input id="warn-case" name="caseId" type="text" maxlength="128" value="@Model.LinkedCaseId" /></div>
                        <button type="submit" class="btn">@L["Issue warning"]</button>
                    </form>
                </details>
            }

            @if (Model.Can("user.suspend") && !Model.IsRestricted)
            {
                <details>
                    <summary><strong>@L["Suspend temporarily"]</strong></summary>
                    <form method="post" asp-page-handler="Suspend" data-confirm="@L["Suspend this account? The member keeps sign-in but loses discovery, likes, chat and calls until it ends."]">
                        <input type="hidden" name="idempotencyKey" value="@Model.FormKey-suspend" />
                        <div class="field"><label for="sus-reason">@L["Reason"]</label>
                            <select id="sus-reason" name="reasonCode" required>
                                @foreach (var r in Vocab.ReasonCodes) { <option value="@r">@L.Code(r)</option> }
                            </select></div>
                        <div class="field"><label for="sus-duration">@L["Duration"]</label>
                            <select id="sus-duration" name="duration" data-custom-target="sus-custom-wrap" required>
                                @foreach (var p in Vocab.SuspensionPresets) { <option value="@p.Value">@L[p.Label]</option> }
                            </select></div>
                        <div class="field" id="sus-custom-wrap" hidden>
                            <label for="sus-custom">@L["Custom length (hours, {0}–{1})", Vocab.MinSuspensionHours, Vocab.MaxSuspensionHours]</label>
                            <input id="sus-custom" name="customHours" type="number" min="@Vocab.MinSuspensionHours" max="@Vocab.MaxSuspensionHours" step="1" />
                        </div>
                        <div class="field"><label for="sus-note">@L["Internal note (required, never shown to the member)"]</label>
                            <textarea id="sus-note" name="internalNote" maxlength="4000" required></textarea></div>
                        <div class="field"><label for="sus-case">@L["Link to case (optional)"]</label>
                            <input id="sus-case" name="caseId" type="text" maxlength="128" value="@Model.LinkedCaseId" /></div>
                        <button type="submit" class="btn btn-danger">@L["Suspend account"]</button>
                    </form>
                </details>
            }

            @if (Model.Can("user.ban") && Model.Status != "banned")
            {
                <details class="card-danger">
                    <summary><strong>@L["Ban permanently"]</strong></summary>
                    <form method="post" asp-page-handler="Ban" data-confirm="@L["Permanently ban this account? Sign-in will be disabled and all sessions revoked."]">
                        <input type="hidden" name="idempotencyKey" value="@Model.FormKey-ban" />
                        <div class="field"><label for="ban-reason">@L["Reason"]</label>
                            <select id="ban-reason" name="reasonCode" required>
                                @foreach (var r in Vocab.ReasonCodes) { <option value="@r">@L.Code(r)</option> }
                            </select></div>
                        <div class="field"><label for="ban-note">@L["Internal note (required)"]</label>
                            <textarea id="ban-note" name="internalNote" maxlength="4000" required></textarea></div>
                        <div class="field"><label for="ban-case">@L["Link to case (optional)"]</label>
                            <input id="ban-case" name="caseId" type="text" maxlength="128" value="@Model.LinkedCaseId" /></div>
                        <div class="field"><label for="ban-confirm">@L["Type BAN to confirm"]</label>
                            <input id="ban-confirm" name="confirmWord" type="text" autocomplete="off" data-confirm-word="BAN" required /></div>
                        <button type="submit" class="btn btn-danger">@L["Ban account"]</button>
                    </form>
                </details>
            }

            @if (Model.Can("user.restore") && Model.IsRestricted)
            {
                <details open>
                    <summary><strong>@L["Restore account"]</strong></summary>
                    <form method="post" asp-page-handler="Restore" data-confirm="@L["Lift the current suspension or ban? The original decision stays in the history."]">
                        <input type="hidden" name="idempotencyKey" value="@Model.FormKey-restore" />
                        <div class="field"><label for="res-reason">@L["Reason"]</label>
                            <select id="res-reason" name="reasonCode" required>
                                @foreach (var r in Vocab.RestoreReasonCodes) { <option value="@r">@L.Code(r)</option> }
                            </select></div>
                        <div class="field"><label for="res-note">@L["Internal note (required)"]</label>
                            <textarea id="res-note" name="internalNote" maxlength="4000" required></textarea></div>
                        <button type="submit" class="btn btn-ok">@L["Restore account"]</button>
                    </form>
                </details>
            }

            @if (Model.Can("verification.require_reverification"))
            {
                <details>
                    <summary><strong>@L["Require re-verification"]</strong></summary>
                    <p class="small muted">@L["Removes the verified badge until the member completes a new session with the identity provider. The console can never mark anyone verified."]</p>
                    <form method="post" asp-page-handler="Reverify" data-confirm="@L["Remove the verified badge and require a new identity verification?"]">
                        <input type="hidden" name="idempotencyKey" value="@Model.FormKey-reverify" />
                        <div class="field"><label for="rv-reason">@L["Reason"]</label>
                            <select id="rv-reason" name="reasonCode" required>
                                @foreach (var r in Vocab.ReasonCodes) { <option value="@r">@L.Code(r)</option> }
                            </select></div>
                        <div class="field"><label for="rv-note">@L["Internal note (required)"]</label>
                            <textarea id="rv-note" name="internalNote" maxlength="4000" required></textarea></div>
                        <button type="submit" class="btn">@L["Require re-verification"]</button>
                    </form>
                </details>
            }

            @if (Model.Can("case.assign"))
            {
                <details>
                    <summary><strong>@L["Open a case"]</strong></summary>
                    <form method="post" asp-page-handler="OpenCase">
                        <div class="field"><label for="oc-type">@L["Type"]</label>
                            <select id="oc-type" name="type">
                                @foreach (var t in Vocab.CaseTypes) { <option value="@t">@L.Code(t)</option> }
                            </select></div>
                        <div class="field"><label for="oc-reason">@L["Reason code"]</label>
                            <select id="oc-reason" name="reasonCode">
                                @foreach (var r in Vocab.ReasonCodes) { <option value="@r">@L.Code(r)</option> }
                            </select></div>
                        <div class="field"><label for="oc-prio">@L["Priority"]</label>
                            <select id="oc-prio" name="priority">
                                @foreach (var p in new[] {"normal", "medium", "high", "critical"}) { <option value="@p">@L.Code(p)</option> }
                            </select></div>
                        <div class="field"><label for="oc-summary">@L["Summary"]</label>
                            <input id="oc-summary" name="summary" type="text" maxlength="300" required /></div>
                        <button type="submit" class="btn">@L["Open case"]</button>
                    </form>
                </details>
            }
        </section>

        <section class="card">
            <h2>@L["Identity verification"]</h2>
            <dl class="kv">
                <dt>@L["Provider"]</dt><dd>@verification.S("provider")</dd>
                <dt>@L["Status"]</dt><dd><span class="status status-@verification.S("status")">@L.Code(verification.Str("status"))</span></dd>
                <dt>@L["Reason"]</dt><dd>@L.Code(verification.Str("reason"))</dd>
                <dt>@L["Verified at"]</dt><dd>@L.When(verification, "verifiedAt")</dd>
                <dt>@L["Updated"]</dt><dd>@L.When(verification, "updatedAt")</dd>
                <dt>@L["Attempts"]</dt><dd>@verification.S("attemptCount", "0")</dd>
                @if (verification.Bool("reverificationRequired"))
                {
                    <dt>@L["Note"]</dt><dd><span class="badge badge-warn">@L["Re-verification required"]</span></dd>
                }
            </dl>
            <p class="boundary">@L["MEVORA stores no ID images, selfies, liveness video or biometric data — only the provider's status."]</p>
        </section>

        <section class="card">
            <h2>@L["Support"]</h2>
            @if (!o.Arr("support").Any())
            {
                <p class="muted">@L["No tickets."]</p>
            }
            else
            {
                <ul>
                    @foreach (var t in o.Arr("support"))
                    {
                        <li>
                            @if (Model.Can("support.read")) { <a href="/Support/@t.S("ticketId")">@t.S("subject")</a> } else { <span>@t.S("subject")</span> }
                            · <span class="status status-@t.S("status")">@L.Code(t.Str("status")?.ToLowerInvariant())</span>
                        </li>
                    }
                </ul>
            }
            <h3>@L["Appeals"]</h3>
            @if (!o.Arr("appeals").Any())
            {
                <p class="muted">@L["No appeals."]</p>
            }
            else
            {
                <ul>
                    @foreach (var a in o.Arr("appeals"))
                    {
                        <li><a href="/Appeals/@a.S("appealId")">@L.Code(a.Str("status"))</a> @(a.Str("decision") is { } d ? $"· {L.Code(d)}" : "")</li>
                    }
                </ul>
            }
        </section>

        <section class="card">
            <h2>@L["Subscription"]</h2>
            <dl class="kv">
                <dt>Premium</dt><dd>@YesNo(subscription.Bool("isPremium"))</dd>
                <dt>@L["Product"]</dt><dd>@subscription.S("productId")</dd>
                <dt>@L["Expires"]</dt><dd>@L.When(subscription, "expiresAt")</dd>
            </dl>
            <p class="boundary">@L["Purchase tokens and billing identifiers never reach the console."]</p>
        </section>

        <p class="boundary">@L["Private conversations are end-to-end encrypted. There is no way to read a member's chats from this console, by design."]</p>
    </div>
</div>
}
