@page
@model Mevora.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Mevora — Daha Anlamlı Eşleşmeler";
    ViewData["Description"] = "Mevora, ortak ilgi alanları ve uyumluluk üzerinden daha anlamlı bağlantılar keşfetmeni sağlayan yeni nesil eşleşme uygulamasıdır.";
}

<section class="hero" aria-labelledby="hero-title">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="container hero-grid">
        <div class="hero-copy reveal">
            <p class="brand-lockup">Mevora</p>
            <h1 id="hero-title">Doğru insanı bulmak sadece eşleşmek değildir.</h1>
            <p class="hero-lead">
                Mevora, ortak ilgi alanları, ilişki beklentileri ve uyumluluk üzerinden daha anlamlı bağlantılar keşfetmeni sağlar.
            </p>
            <div class="hero-cta">
                <a class="btn btn-primary" href="#mevora">Mevora’yı Keşfet</a>
                <a class="btn btn-ghost" href="#support">Destek Al</a>
            </div>
        </div>
        <div class="hero-visual reveal" aria-hidden="true">
            <div class="phone-frame phone-frame-hero">
                <div class="phone-screen phone-screen-discover">
                    <span class="phone-label">Discover</span>
                    <div class="compat-chip">87% uyum</div>
                    <div class="phone-card-stack">
                        <div class="phone-card"></div>
                        <div class="phone-card phone-card-front"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section" id="mevora" aria-labelledby="about-title">
    <div class="container">
        <div class="section-head reveal">
            <p class="eyebrow">Mevora Nedir?</p>
            <h2 id="about-title">Anlamlı keşif için tasarlandı</h2>
            <p>Kısa kaydırmalar değil; ortak zemin, net beklenti ve bilinçli bağlantı.</p>
        </div>
        <div class="pillar-grid">
            <article class="pillar reveal"><h3>Anlamlı eşleşmeler</h3><p>Karşılıklı ilgi ve uyum odaklı keşif.</p></article>
            <article class="pillar reveal"><h3>Uyumluluk yüzdesi</h3><p>Compatibility Engine ile ölçülebilir sinyal.</p></article>
            <article class="pillar reveal"><h3>Ortak ilgi alanları</h3><p>Paylaşılan zevkleri öne çıkarır.</p></article>
            <article class="pillar reveal"><h3>İlişki beklentileri</h3><p>Aynı yolu arayan insanlarla buluş.</p></article>
            <article class="pillar reveal"><h3>Soru-cevap uyumu</h3><p>Derin tercihleri görünür kılar.</p></article>
            <article class="pillar reveal"><h3>Bilinçli keşif</h3><p>Daha az gürültü, daha iyi karar.</p></article>
            <article class="pillar reveal"><h3>Mesajlaşma</h3><p>Eşleştikten sonra güvenli sohbet.</p></article>
            <article class="pillar reveal"><h3>Güvenli deneyim</h3><p>Engelle, bildir, hesabını koru.</p></article>
        </div>
    </div>
</section>

<section class="section section-alt" id="how" aria-labelledby="how-title">
    <div class="container">
        <div class="section-head reveal">
            <p class="eyebrow">Nasıl Çalışır?</p>
            <h2 id="how-title">Dört adımda Mevora</h2>
            <p>Profilinden konuşmaya — net ve akıcı bir akış.</p>
        </div>
        <ol class="steps">
            <li class="step reveal">
                <span class="step-num">01</span>
                <div class="step-icon" aria-hidden="true">◎</div>
                <h3>Profilini oluştur</h3>
                <p>Fotoğrafların, ilgilerin ve beklentilerinle kendini tanıt.</p>
            </li>
            <li class="step reveal">
                <span class="step-num">02</span>
                <div class="step-icon" aria-hidden="true">◈</div>
                <h3>Seni tanıyalım</h3>
                <p>İlişki soruları ve tercihlerle uyum sinyallerini netleştir.</p>
            </li>
            <li class="step reveal">
                <span class="step-num">03</span>
                <div class="step-icon" aria-hidden="true">◇</div>
                <h3>Uyumluluğunu keşfet</h3>
                <p>Compatibility Engine önerileri önceliklendirir.</p>
            </li>
            <li class="step reveal">
                <span class="step-num">04</span>
                <div class="step-icon" aria-hidden="true">✦</div>
                <h3>Eşleş ve konuş</h3>
                <p>Karşılıklı beğeniden sonra mesajlaşmaya başla.</p>
            </li>
        </ol>
    </div>
</section>

<section class="section" id="features" aria-labelledby="features-title">
    <div class="container">
        <div class="section-head reveal">
            <p class="eyebrow">Özellikler</p>
            <h2 id="features-title">Modern eşleşme araçları</h2>
            <p>Keşiften mesaja, güvenliğe kadar tek deneyimde.</p>
        </div>
        <div class="feature-grid">
            <article class="feature-card reveal"><h3>Compatibility Engine</h3><p>Çok sinyalli uyumluluk modeli.</p></article>
            <article class="feature-card reveal"><h3>Akıllı eşleşme</h3><p>Daha anlamlı öneriler.</p></article>
            <article class="feature-card reveal"><h3>Soru-cevap sistemi</h3><p>Değerleri ve tercihleri görünür kılar.</p></article>
            <article class="feature-card reveal"><h3>Profil uyumluluğu</h3><p>Ortak zeminleri vurgular.</p></article>
            <article class="feature-card reveal"><h3>Mesajlaşma</h3><p>Eşleşmelerde güvenli sohbet.</p></article>
            <article class="feature-card reveal"><h3>Fotoğraf paylaşımı</h3><p>Profil ve sohbet medyası.</p></article>
            <article class="feature-card reveal"><h3>Sesli mesaj</h3><p>Metnin ötesinde bağlantı.</p></article>
            <article class="feature-card reveal"><h3>Konum tabanlı keşif</h3><p>Yakınındaki insanları gizlilikle gösterir.</p></article>
            <article class="feature-card reveal"><h3>Spotify’a hazır</h3><p>Müzik uyumu için genişletilebilir yapı.</p></article>
            <article class="feature-card reveal"><h3>Boost sistemi</h3><p>Keşfedilebilirliğini geçici artır.</p></article>
            <article class="feature-card reveal"><h3>Güvenli hesap</h3><p>Kimlik, gizlilik ve kontrol sende.</p></article>
        </div>
    </div>
</section>

<section class="section engine-section" id="engine" aria-labelledby="engine-title">
    <div class="container engine-grid">
        <div class="engine-copy reveal">
            <p class="eyebrow">Farklılaştırıcı</p>
            <h2 id="engine-title">Mevora Compatibility Engine</h2>
            <p>
                Mevora sadece iki kişiyi rastgele eşleştirmez. Profil bilgileri, ortak ilgi alanları,
                ilişki beklentileri ve soru-cevap uyumluluğu gibi sinyalleri kullanarak daha anlamlı
                eşleşmeler oluşturmayı hedefler.
            </p>
        </div>
        <div class="score-panel reveal" role="img" aria-label="Örnek uyumluluk skoru yüzde 87, yüksek uyumluluk">
            <div class="score-ring">
                <span class="score-value">87%</span>
            </div>
            <p class="score-label">Yüksek Uyumluluk</p>
            <ul class="score-signals">
                <li>Ortak ilgi alanları</li>
                <li>İlişki beklentisi</li>
                <li>Soru-cevap örtüşmesi</li>
            </ul>
        </div>
    </div>
</section>

<section class="section section-alt" id="screens" aria-labelledby="screens-title">
    <div class="container">
        <div class="section-head reveal">
            <p class="eyebrow">Uygulama</p>
            <h2 id="screens-title">Ekranlar</h2>
            <p>Keşiften mesaja kadar Mevora deneyimi.</p>
        </div>
        <div class="screens-row">
            @{
                var screens = new (string Id, string Label, string Class, string? Image)[]
                {
                    ("discover", "Discover", "phone-screen-discover", "/images/screens/discover.png"),
                    ("profile", "Profile", "phone-screen-profile", "/images/screens/profile.png"),
                    ("compat", "Compatibility", "phone-screen-compat", null),
                    ("match", "Match", "phone-screen-match", "/images/screens/match.png"),
                    ("messages", "Messages", "phone-screen-messages", null),
                };
            }
            @foreach (var screen in screens)
            {
                <figure class="phone-frame reveal">
                    <div class="phone-screen @screen.Class">
                        <span class="phone-label">@screen.Label</span>
                        @if (screen.Id == "compat")
                        {
                            <div class="compat-chip">92%</div>
                        }
                        @if (!string.IsNullOrEmpty(screen.Image))
                        {
                            <img class="phone-shot" src="@screen.Image" alt="@screen.Label ekran görüntüsü" loading="lazy" width="360" height="760" />
                        }
                    </div>
                    <figcaption>@screen.Label</figcaption>
                </figure>
            }
        </div>
        <p class="screens-note">Ekran görselleri yer tutucudur; gerçek uygulamadan asset’ler kolayca değiştirilebilir.</p>
    </div>
</section>

<section class="section" id="faq" aria-labelledby="faq-title">
    <div class="container narrow">
        <div class="section-head reveal">
            <p class="eyebrow">SSS</p>
            <h2 id="faq-title">Sık sorulan sorular</h2>
            <p>Hızlı yanıtlar. Daha fazlası için destek formu.</p>
        </div>
        @if (Model.FaqsFromFallback)
        {
            <p class="fallback-note" role="status">İçerik yerel yedekten gösteriliyor.</p>
        }
        <div class="faq-list">
            @foreach (var item in Model.Faqs)
            {
                <details class="faq-item reveal">
                    <summary>@item.Question</summary>
                    <p>@item.Answer</p>
                </details>
            }
        </div>
    </div>
</section>

<section class="section section-alt" id="support" aria-labelledby="support-title">
    <div class="container">
        <div class="section-head reveal">
            <p class="eyebrow">Destek</p>
            <h2 id="support-title">Nasıl yardımcı olabiliriz?</h2>
            <p>Kategori seç, talebini gönder — ekibimiz incelesin.</p>
        </div>

        <div class="support-categories" role="list">
            @foreach (var cat in SupportCategories.All)
            {
                <button type="button"
                        class="support-chip @(Model.SupportForm.Category == cat.Value ? "is-active" : string.Empty)"
                        data-category="@cat.Value"
                        role="listitem">
                    @cat.Label
                </button>
            }
        </div>

        @if (Model.SubmissionSucceeded)
        {
            <div class="alert alert-success reveal" role="status">
                Destek talebiniz başarıyla oluşturuldu.
                @if (!string.IsNullOrEmpty(Model.CreatedTicketId))
                {
                    <span class="ticket-id">Talep no: @Model.CreatedTicketId</span>
                }
            </div>
        }
        else if (!string.IsNullOrEmpty(Model.SubmissionError))
        {
            <div class="alert alert-error reveal" role="alert">@Model.SubmissionError</div>
        }

        <form method="post"
              enctype="multipart/form-data"
              class="support-form reveal"
              id="supportForm"
              asp-fragment="support"
              novalidate>
            @Html.AntiForgeryToken()
            <div class="form-grid">
                <div class="field">
                    <label asp-for="SupportForm.Name"></label>
                    <input asp-for="SupportForm.Name" autocomplete="name" />
                    <span asp-validation-for="SupportForm.Name" class="field-error"></span>
                </div>
                <div class="field">
                    <label asp-for="SupportForm.Email"></label>
                    <input asp-for="SupportForm.Email" autocomplete="email" inputmode="email" />
                    <span asp-validation-for="SupportForm.Email" class="field-error"></span>
                </div>
                <div class="field">
                    <label asp-for="SupportForm.UserId"></label>
                    <input asp-for="SupportForm.UserId" autocomplete="off" placeholder="Uygulama kullanıcı ID (isteğe bağlı)" />
                    <span asp-validation-for="SupportForm.UserId" class="field-error"></span>
                </div>
                <div class="field">
                    <label asp-for="SupportForm.Category"></label>
                    <select asp-for="SupportForm.Category" id="supportCategory">
                        <option value="">Kategori seçin</option>
                        @foreach (var cat in SupportCategories.All)
                        {
                            <option value="@cat.Value">@cat.Label</option>
                        }
                    </select>
                    <span asp-validation-for="SupportForm.Category" class="field-error"></span>
                </div>
                <div class="field field-span">
                    <label asp-for="SupportForm.Subject"></label>
                    <input asp-for="SupportForm.Subject" />
                    <span asp-validation-for="SupportForm.Subject" class="field-error"></span>
                </div>
                <div class="field field-span">
                    <label asp-for="SupportForm.Description"></label>
                    <textarea asp-for="SupportForm.Description" rows="5"></textarea>
                    <span asp-validation-for="SupportForm.Description" class="field-error"></span>
                </div>
                <div class="field">
                    <label asp-for="SupportForm.Priority"></label>
                    <select asp-for="SupportForm.Priority">
                        <option value="@SupportPriorities.Low">Düşük</option>
                        <option value="@SupportPriorities.Normal">Normal</option>
                        <option value="@SupportPriorities.High">Yüksek</option>
                        <option value="@SupportPriorities.Urgent">Acil</option>
                    </select>
                    <span asp-validation-for="SupportForm.Priority" class="field-error"></span>
                </div>
                <div class="field">
                    <label asp-for="SupportForm.Screenshot"></label>
                    <input asp-for="SupportForm.Screenshot" type="file" accept="image/jpeg,image/png,image/webp" />
                    <span class="field-hint">JPEG, PNG veya WebP — en fazla 5 MB</span>
                    <span asp-validation-for="SupportForm.Screenshot" class="field-error"></span>
                </div>
            </div>
            <button type="submit" class="btn btn-primary">Talebi Gönder</button>
        </form>
    </div>
</section>

<section class="section legal-teaser" aria-labelledby="legal-title">
    <div class="container legal-row reveal">
        <div>
            <h2 id="legal-title">Gizlilik &amp; koşullar</h2>
            <p>Verini nasıl işlediğimizi ve hizmet kurallarını şeffaf tutuyoruz.</p>
        </div>
        <div class="legal-actions">
            <a class="btn btn-ghost" href="/privacy">Gizlilik Politikası</a>
            <a class="btn btn-ghost" href="/terms">Kullanım Koşulları</a>
        </div>
    </div>
</section>
